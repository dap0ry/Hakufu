<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Hakufu"
             xmlns:conv="using:Hakufu.Converters"
             x:Class="Hakufu.App"
             RequestedThemeVariant="Light">

    <!-- ViewModel → View por convención (XxxViewModel → XxxView), ver ViewLocator. -->
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Hakufu/Assets/Styles/GlobalStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Tema activo: lo sustituye ThemeService en tiempo de ejecución -->
                <ResourceInclude Source="avares://Hakufu/Assets/Themes/LightTheme.axaml"/>
                <ResourceInclude Source="avares://Hakufu/Assets/Styles/PixelIcons.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Marca: el rojo del fondo de Inicio y la tipografía condensada de
                 los rótulos (Archivo, OFL — ver Assets/Fonts/OFL-Archivo.txt).
                 Igual en los dos temas. -->
            <SolidColorBrush x:Key="BrandRed" Color="#E5001A"/>
            <SolidColorBrush x:Key="NoBrush"  Color="Transparent"/>
            <FontFamily x:Key="DisplayFont">avares://Hakufu/Assets/Fonts/HakufuDisplay-Black.ttf#Hakufu Display</FontFamily>
            <FontFamily x:Key="DisplayFontSemi">avares://Hakufu/Assets/Fonts/HakufuDisplaySemi-Bold.ttf#Hakufu Display Semi</FontFamily>

            <!-- Converters -->
            <conv:EqualityConverter x:Key="EqualityConverter"/>
            <conv:PercentageWidthConverter x:Key="PercentageWidth"/>
            <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
            <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
            <conv:PathAndOpacityToImageBrushConverter x:Key="PathAndOpacityToImageBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
