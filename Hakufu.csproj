<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- solo para el icono de la bandeja del sistema (NotifyIcon) -->
    <AssemblyName>Hakufu</AssemblyName>
    <RootNamespace>Hakufu</RootNamespace>
    <ApplicationIcon>HakufuLogo.ico</ApplicationIcon>
    <Version>0.9.4</Version>
    <AssemblyVersion>0.9.4.0</AssemblyVersion>
    <FileVersion>0.9.4.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    UseWindowsForms=true (solo para NotifyIcon en TrayIconService) hace que el
    SDK añada "using System.Windows.Forms;" implícito a TODO el proyecto, lo
    que choca con "UserControl"/"Application" de WPF en cada vista. Se quita
    aquí el using global; TrayIconService.cs pone el suyo propio, local.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\**\*.png" />
    <Resource Include="HakufuLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
    <PackageReference Include="SharpCompress" Version="0.47.4" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
