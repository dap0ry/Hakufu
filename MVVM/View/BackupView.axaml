<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.BackupView"
             x:DataType="vm:BackupViewModel">

    <UserControl.Styles>
        <!-- Rótulo de sección (BIBLIOTECA, CREAR COPIA…) -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Texto explicativo de las tarjetas -->
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Aviso en gris (restaurar) -->
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Mensaje de estado: éxito normal, error en tono secundario con icono de aviso -->
        <Style Selector="Border.status">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        </Style>
        <Style Selector="Border.status.error">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Border.status SelectableTextBlock#StatusText">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Border.status.error SelectableTextBlock#StatusText">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- Barra de progreso fina, colores del tema -->
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="4"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource ProgressFill}"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,24">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Classes="ghost"
                        Content="← Inicio"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="COPIA DE SEGURIDAD"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,2"/>
                    <TextBlock Classes="caption"
                               Text="Guarda tu biblioteca en un archivo .zip y recupérala en este u otro equipo"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,36,40,40" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Progreso -->
                <Border Classes="card" Padding="16,14" Margin="0,0,0,24"
                        IsVisible="{Binding IsBusy}">
                    <StackPanel Spacing="10">
                        <ProgressBar Classes="thin"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding Progress, StringFormat='Trabajando… {0:0} %'}"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de estado -->
                <Border Classes="card status" Padding="16,14" Margin="0,0,0,24"
                        Classes.error="{Binding !IsSuccess}"
                        IsVisible="{Binding HasStatus}">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Icono: ✓ si ha ido bien, ! si no -->
                        <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                              VerticalAlignment="Top" Stretch="Uniform"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M1,7 L5,11 L13,2"
                              Stroke="{DynamicResource AccentColor}"
                              IsVisible="{Binding IsSuccess}"/>
                        <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                              VerticalAlignment="Top" Stretch="None"
                              Fill="{DynamicResource TextSecondary}"
                              Data="F0 M7,0 A7,7 0 1 1 6.99,0 Z M6,3 L8,3 L7.6,8.5 L6.4,8.5 Z M6,10 L8,10 L8,12 L6,12 Z"
                              IsVisible="{Binding !IsSuccess}"/>
                        <SelectableTextBlock Grid.Column="1" Name="StatusText"
                                             Text="{Binding StatusMessage}"
                                             FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ── BIBLIOTECA ── -->
                <TextBlock Classes="section" Text="BIBLIOTECA"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                            <ContentControl Template="{StaticResource IconPixelBooks}"
                                            Width="18" Height="18"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Classes="cardTitle" Margin="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding SummaryText}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="body"
                                       VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="Carpeta de datos: "/>
                                <Run Text="{Binding DataFolder}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Padding="14,8"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenDataFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentControl Template="{StaticResource IconPixelFolder}"
                                                    Width="13" Height="13"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="Abrir carpeta" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,32"/>

                <!-- ── CREAR COPIA ── -->
                <TextBlock Classes="section" Text="CREAR COPIA"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="Exportar tu biblioteca"/>
                        <TextBlock Classes="body" Margin="0,0,0,8"
                                   Text="Crea un archivo .zip con tus colecciones, el progreso de lectura, el historial, las portadas, tu perfil y el tema. Guárdalo donde quieras: un disco externo, un pendrive u otra carpeta."/>
                        <TextBlock Classes="body" FontSize="11" Margin="0,0,0,20"
                                   Text="Los mangas no van en la copia: son tu carpeta de la biblioteca. Para llevarlos a otro equipo, copia esa carpeta tal cual."/>

                        <Button Classes="primary"
                                Content="Exportar copia…"
                                HorizontalAlignment="Left" Padding="22,10"
                                Command="{Binding ExportCommand}"/>
                    </StackPanel>
                </Border>

                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,32"/>

                <!-- ── RESTAURAR COPIA ── -->
                <TextBlock Classes="section" Text="RESTAURAR COPIA"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="Recuperar una copia de seguridad"/>
                        <TextBlock Classes="body" Margin="0,0,0,20"
                                   Text="Elige un .zip creado con Hakufu. Sirve también para pasar la biblioteca a otro equipo, aunque sea Mac o Linux: el progreso se aplica a los tomos de tu carpeta de la biblioteca que estén en la misma subcarpeta y con el mismo nombre."/>

                        <Button Classes="primary"
                                Content="Elegir copia…"
                                HorizontalAlignment="Left" Padding="22,10"
                                Command="{Binding PickRestoreCommand}"
                                IsVisible="{Binding !IsConfirmingRestore}"/>

                        <StackPanel IsVisible="{Binding IsConfirmingRestore}">
                            <Border Classes="notice" Margin="0,0,0,14">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                                          VerticalAlignment="Top" Stretch="None"
                                          Fill="{DynamicResource TextPrimary}"
                                          Data="F0 M7,0 A7,7 0 1 1 6.99,0 Z M6,3 L8,3 L7.6,8.5 L6.4,8.5 Z M6,10 L8,10 L8,12 L6,12 Z"/>
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                               Text="La copia sustituirá tu biblioteca actual: colecciones, progreso, historial y perfil. Lo que no esté en la copia se perderá (tus archivos de manga no se tocan). ¿Continuar?"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary"
                                        Content="Restaurar"
                                        Padding="22,10"
                                        Command="{Binding ConfirmRestoreCommand}"/>
                                <Button Classes="ghost"
                                        Content="Cancelar"
                                        Padding="22,10"
                                        Command="{Binding CancelRestoreCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── NOTA: TODO LOCAL ── -->
                <Border Classes="notice">
                    <TextBlock Classes="body" FontSize="11" LineHeight="18"
                               Text="La copia es un archivo .zip que se queda en tu equipo, donde tú la guardes. Hakufu no la sube a ningún sitio ni se conecta a internet."/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
