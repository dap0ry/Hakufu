<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.BackupView"
             x:DataType="vm:BackupViewModel">

    <UserControl.Styles>
        <!-- Rótulo de sección (BIBLIOTECA, CREAR COPIA…) -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Texto explicativo de las tarjetas -->
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Aviso en gris (restaurar) -->
        <Style Selector="Border.notice">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Mensaje de estado: éxito normal, error en tono secundario con icono de aviso -->
        <Style Selector="Border.status">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        </Style>
        <Style Selector="Border.status.error">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Border.status SelectableTextBlock#StatusText">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Border.status.error SelectableTextBlock#StatusText">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- Casillas de colecciones: la marca, del color del fondo (si no, en tema
             oscuro sale blanca sobre la casilla blanca) -->
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource AppBackground}"/>
        </Style>

        <!-- Barra de progreso fina, colores del tema -->
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="4"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource ProgressFill}"/>
            <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <c:PageHeader Grid.Row="0"
                      Title="{i18n:T backup.title}"
                      Subtitle="{i18n:T backup.subtitle}"
                      BackText="{i18n:T common.back_home}"
                      BackCommand="{Binding GoBackCommand}">
        </c:PageHeader>

        <!-- ═══ BODY ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,36,40,40" MaxWidth="620" HorizontalAlignment="Left">

                <!-- Progreso -->
                <Border Classes="card" Padding="16,14" Margin="0,0,0,24"
                        IsVisible="{Binding IsBusy}">
                    <StackPanel Spacing="10">
                        <ProgressBar Classes="thin"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding ProgressText}"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de estado -->
                <Border Classes="card status" Padding="16,14" Margin="0,0,0,24"
                        Classes.error="{Binding !IsSuccess}"
                        IsVisible="{Binding HasStatus}">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Icono: ✓ si ha ido bien, ! si no -->
                        <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                              VerticalAlignment="Top" Stretch="Uniform"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M1,7 L5,11 L13,2"
                              Stroke="{DynamicResource AccentColor}"
                              IsVisible="{Binding IsSuccess}"/>
                        <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                              VerticalAlignment="Top" Stretch="None"
                              Fill="{DynamicResource TextSecondary}"
                              Data="F0 M7,0 A7,7 0 1 1 6.99,0 Z M6,3 L8,3 L7.6,8.5 L6.4,8.5 Z M6,10 L8,10 L8,12 L6,12 Z"
                              IsVisible="{Binding !IsSuccess}"/>
                        <SelectableTextBlock Grid.Column="1" Name="StatusText"
                                             Text="{Binding StatusMessage}"
                                             FontSize="12" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ── BIBLIOTECA ── -->
                <TextBlock Classes="section" Text="{i18n:T backup.section_library}"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                            <ContentControl Template="{StaticResource IconPixelBooks}"
                                            Width="18" Height="18"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"/>
                            <TextBlock Classes="cardTitle" Margin="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding SummaryText}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="body"
                                       VerticalAlignment="Center" Margin="0,0,16,0">
                                <Run Text="{i18n:T backup.data_folder}"/>
                                <Run Text="{Binding DataFolder}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Padding="14,8"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenDataFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentControl Template="{StaticResource IconPixelFolder}"
                                                    Width="13" Height="13"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="{i18n:T backup.open_folder}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,32"/>

                <!-- ── CREAR COPIA ── -->
                <TextBlock Classes="section" Text="{i18n:T backup.section_create}"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="{i18n:T backup.export_title}"/>
                        <TextBlock Classes="body" Margin="0,0,0,18"
                                   Text="{i18n:T backup.export_body}"/>

                        <!-- Colecciones: sí o no, y cuáles -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsVisible="{Binding HasCollections}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{i18n:T backup.include_collections}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Classes="body" FontSize="11"
                                           Text="{i18n:T backup.include_collections_hint}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Classes="themeToggle"
                                          IsChecked="{Binding IncludeCollections}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <Border Classes="notice" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasCollections"/>
                                    <Binding Path="IncludeCollections"/>
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,8,12,4">
                                    <Button Classes="ghost" Content="{i18n:T backup.select_all}" Padding="10,4" FontSize="11"
                                            Command="{Binding SelectAllCollectionsCommand}"/>
                                    <Button Classes="ghost" Content="{i18n:T backup.select_none}" Padding="10,4" FontSize="11"
                                            Command="{Binding SelectNoCollectionsCommand}"/>
                                </StackPanel>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CollectionOptions}" Margin="12,0,12,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BackupCollectionOption">
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMuted}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Button Classes="primary"
                                    Content="{i18n:T backup.export_button}"
                                    Padding="22,10"
                                    Command="{Binding ExportCommand}"/>
                            <TextBlock Classes="body" Text="{Binding ExportSummary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,32"/>

                <!-- ── RESTAURAR COPIA ── -->
                <TextBlock Classes="section" Text="{i18n:T backup.section_restore}"/>

                <Border Classes="card" Padding="28,24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Classes="cardTitle" Text="{i18n:T backup.restore_title}"/>
                        <TextBlock Classes="body" Margin="0,0,0,20"
                                   Text="{i18n:T backup.restore_body}"/>

                        <Button Classes="primary"
                                Content="{i18n:T backup.pick_button}"
                                HorizontalAlignment="Left" Padding="22,10"
                                Command="{Binding PickRestoreCommand}"
                                IsVisible="{Binding !IsConfirmingRestore}"/>

                        <StackPanel IsVisible="{Binding IsConfirmingRestore}">
                            <Border Classes="notice" Margin="0,0,0,14">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Grid.Column="0" Width="14" Height="14" Margin="0,1,10,0"
                                          VerticalAlignment="Top" Stretch="None"
                                          Fill="{DynamicResource TextPrimary}"
                                          Data="F0 M7,0 A7,7 0 1 1 6.99,0 Z M6,3 L8,3 L7.6,8.5 L6.4,8.5 Z M6,10 L8,10 L8,12 L6,12 Z"/>
                                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                               Text="{i18n:T backup.restore_confirm}"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="primary"
                                        Content="{i18n:T backup.restore_button}"
                                        Padding="22,10"
                                        Command="{Binding ConfirmRestoreCommand}"/>
                                <Button Classes="ghost"
                                        Content="{i18n:T backup.cancel}"
                                        Padding="22,10"
                                        Command="{Binding CancelRestoreCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── NOTA: TODO LOCAL ── -->
                <Border Classes="notice">
                    <TextBlock Classes="body" FontSize="11" LineHeight="18"
                               Text="{i18n:T backup.local_note}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
