<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.CollectionDetailView"
             x:DataType="vm:CollectionDetailViewModel">

    <UserControl.Styles>
        <!-- Tarjeta de manga: botón sin cromo que se aclara al pasar el ratón
             (en WPF era un Border con MouseBinding). -->
        <Style Selector="Button.mangaCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="Transparent">
                        <ContentPresenter Name="ContentHost"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.mangaCard Grid#Cover">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mangaCard:pointerover Grid#Cover">
            <Setter Property="RenderTransform" Value="translateY(-5px)"/>
        </Style>

        <!-- Estrella: solo al pasar el ratón, o siempre si ya es favorito -->
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="ContentHost"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.mangaCard:pointerover Button.star, Button.star.isFavorite">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ContentControl.starIcon">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>
        <Style Selector="ContentControl.starIcon.favorite">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Botones de ordenar: el activo, relleno -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Cabecera -->
        <Border Grid.Row="0" Padding="40,26,40,0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="ghost" Content="{i18n:T collection.back}"
                            VerticalAlignment="Center"
                            Command="{Binding GoBackCommand}"/>

                    <StackPanel Grid.Column="1" Margin="28,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CollectionName}"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="52" LineHeight="50"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="12" Margin="1,4,0,0"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Los tomos se añaden o quitan en su carpeta; luego "Actualizar" en la biblioteca -->
                        <Button Classes="primary" Content="{i18n:T collection.open_folder}" Padding="18,10"
                                Command="{Binding OpenFolderCommand}"
                                ToolTip.Tip="{i18n:T collection.open_folder_tip}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           FontSize="13" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- Ordenar + tamaño -->
                <Grid ColumnDefinitions="Auto,*,Auto,160" Margin="0,22,0,0" Height="52">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{i18n:T collection.sort}" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Classes="ghost chip" Content="{i18n:T collection.sort_name}"
                                Command="{Binding SortByNameCommand}"
                                Opacity="{Binding IsSortByName, Converter={StaticResource BoolToOpacity}}"/>
                        <Button Classes="ghost chip" Content="{i18n:T collection.sort_date}"
                                Command="{Binding SortByDateCommand}"
                                Opacity="{Binding IsSortByDate, Converter={StaticResource BoolToOpacity}}"/>
                        <Button Classes="ghost chip" Content="{i18n:T collection.sort_custom}"
                                Command="{Binding OpenReorderCommand}"
                                Opacity="{Binding IsSortByCustom, Converter={StaticResource BoolToOpacity}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{i18n:T collection.size}" Classes="caption"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- Más columnas = portadas más pequeñas: el deslizador va al revés para que
                         a la derecha se vean más grandes -->
                    <Slider Grid.Column="3" Classes="compact"
                            Minimum="3" Maximum="10" SmallChange="1" LargeChange="1"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            IsDirectionReversed="True"
                            Value="{Binding ItemsPerRow}"
                            VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerBrush}"/>
            </StackPanel>
        </Border>

        <!-- Manga grid -->
        <ScrollViewer Grid.Row="1" Padding="30,28,30,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Mangas}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding $parent[UserControl].((vm:CollectionDetailViewModel)DataContext).ItemsPerRow}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MangaCardViewModel">
                        <Button Classes="mangaCard"
                                Margin="10,0,10,28"
                                Command="{Binding $parent[UserControl].((vm:CollectionDetailViewModel)DataContext).CardClickCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid Name="Cover">
                                    <Border CornerRadius="4" ClipToBounds="True"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                            BoxShadow="0 6 16 0 #2E000000">
                                        <Image Source="{Binding Cover}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    </Border>
                                    <!-- Favorito -->
                                    <Button Classes="star"
                                            Classes.isFavorite="{Binding IsFavorite}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="8,8,0,0"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            ToolTip.Tip="{i18n:T collection.favorite_tip}">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#80000000">
                                            <ContentControl Classes="starIcon"
                                                            Classes.favorite="{Binding IsFavorite}"
                                                            Template="{StaticResource IconPixelStar}"
                                                            Width="12" Height="12"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{DynamicResource DisplayFontSemi}"
                                           FontSize="16"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,10,0,0"
                                           ToolTip.Tip="{Binding Title}"/>
                                <TextBlock Text="{Binding PageText}"
                                           FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextMuted}"/>

                                <!-- Progreso -->
                                <Grid Height="3" Margin="0,8,0,0" IsVisible="{Binding IsStarted}">
                                    <Rectangle Fill="{DynamicResource ProgressTrack}"/>
                                    <Rectangle Fill="{DynamicResource ProgressFill}" HorizontalAlignment="Left">
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource PercentageWidth}">
                                                <Binding Path="ProgressPct"/>
                                                <Binding Path="$parent[Grid].Bounds.Width"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                    </Rectangle>
                                </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
