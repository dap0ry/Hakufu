<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             x:Class="Hakufu.MVVM.View.Controls.PageHeader"
             x:DataType="c:PageHeader">

    <!-- Cabecera de las pantallas interiores, la misma en todas (la de Biblioteca):
         volver · título grande en la condensada · una línea debajo · acciones a la derecha. -->
    <Border Padding="40,26,40,22"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Classes="ghost"
                    Content="{Binding BackText, RelativeSource={RelativeSource AncestorType=c:PageHeader}}"
                    Command="{Binding BackCommand, RelativeSource={RelativeSource AncestorType=c:PageHeader}}"
                    VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Margin="28,0,24,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=c:PageHeader}}"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="52" LineHeight="50"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=c:PageHeader}}"
                           IsVisible="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=c:PageHeader}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="12" Margin="1,4,0,0"
                           Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>

            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                              Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=c:PageHeader}}"/>
        </Grid>
    </Border>
</UserControl>
