<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.CustomizationView"
             x:DataType="vm:CustomizationViewModel">

    <UserControl.Resources>
        <!-- Tarjeta de un hueco de personalización — pensada para vivir en una
             cuadrícula de 3 columnas: miniatura grande arriba, etiqueta,
             opacidad (si ya hay imagen) y acciones abajo. -->
        <DataTemplate x:Key="CustomizationSlotCardTemplate" x:DataType="vm:ImageSlotViewModel">
            <Border Classes="card" Padding="14" Margin="0,0,16,16">
                <StackPanel>
                    <Border Height="104" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource AppBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Sin imagen" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasImage}"/>
                            <Image Source="{Binding ImagePath, Converter={StaticResource PathToBitmap}}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                   IsVisible="{Binding HasImage}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Label}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" Height="32"
                               Margin="0,0,0,10"/>

                    <!-- Opacidad — solo tiene sentido si ya hay imagen elegida -->
                    <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto"
                          IsVisible="{Binding HasImage}">
                        <TextBlock Grid.Column="0" Text="Opacidad" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" Classes="compact"
                                Minimum="0.05" Maximum="1"
                                Value="{Binding Opacity}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="30"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ghost"
                                Content="Elegir" FontSize="11" Padding="12,7"
                                Margin="0,0,8,0"
                                Command="{Binding PickCommand}"/>
                        <Button Classes="ghost"
                                Content="Quitar" FontSize="11" Padding="12,7"
                                Command="{Binding RemoveCommand}"
                                IsVisible="{Binding HasImage}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,24">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Classes="ghost"
                        Content="← Inicio"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,24,0"/>
                <TextBlock Grid.Column="1" Text="PERSONALIZAR"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="40">

                <TextBlock Text="Imágenes locales para el wallpaper general (se ve detrás de toda la app), el menú de Inicio y sus botones — solo en este dispositivo, nunca se suben a ningún sitio."
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding CustomizationSlots}"
                              ItemTemplate="{StaticResource CustomizationSlotCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
