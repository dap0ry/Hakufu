<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.EditProfileView"
             x:DataType="vm:EditProfileViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel#EditProfileRoot">
            <Setter Property="Width" Value="400"/>
        </Style>
        <Style Selector=".compact StackPanel#EditProfileRoot">
            <Setter Property="Width" Value="NaN"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Name="EditProfileRoot">
        <TextBlock Text="{i18n:T profile.edit}" Classes="subtitle" Margin="0,0,0,24"/>

        <!-- Foto -->
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,24">
            <Border Grid.Column="0" Width="84" Height="84" CornerRadius="42"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    ClipToBounds="True">
                <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="8">
                <Button Classes="ghost" Content="{i18n:T profile.edit.choose_photo}" HorizontalAlignment="Left"
                        Command="{Binding ChooseAvatarCommand}"/>
                <Button Classes="ghost" Content="{i18n:T profile.edit.remove_photo}" HorizontalAlignment="Left"
                        IsVisible="{Binding HasAvatar}"
                        Command="{Binding RemoveAvatarCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{i18n:T profile.edit.name}" Classes="caption" Margin="0,0,0,6"/>
        <TextBox Text="{Binding Name}" MaxLength="40" Watermark="{i18n:T profile.edit.name_hint}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="{i18n:T profile.edit.favorite}" Classes="caption" Margin="0,0,0,6"/>
        <ComboBox ItemsSource="{Binding FavoriteOptions}"
                  SelectedItem="{Binding Favorite}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,28"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="{i18n:T profile.edit.cancel}" Margin="0,0,12,0"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="primary" Content="{i18n:T profile.edit.save}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
