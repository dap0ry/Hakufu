<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.HelpView"
             x:DataType="vm:HelpViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,24">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Classes="ghost"
                        Content="← Inicio"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,24,0"/>
                <TextBlock Grid.Column="1" Text="AYUDA"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══
             El ScrollViewer de Avalonia ya estira el contenido al alto visible,
             así que VerticalAlignment="Center" centra sin el MinHeight de WPF. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="40,40,40,40">

                <TextBlock Text="Los atajos de teclado del lector están en Ajustes, y puedes cambiarlos."
                           FontSize="13" MaxWidth="820" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondary}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
