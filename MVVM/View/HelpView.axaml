<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.HelpView"
             x:DataType="vm:HelpViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,24">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Classes="ghost"
                        Content="← Inicio"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,24,0"/>
                <TextBlock Grid.Column="1" Text="AYUDA"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══
             El ScrollViewer de Avalonia ya estira el contenido al alto visible,
             así que VerticalAlignment="Center" centra sin el MinHeight de WPF. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="40,40,40,40">

                <TextBlock Text="Los atajos de teclado del lector están en Ajustes, y puedes cambiarlos."
                           FontSize="13" MaxWidth="820" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondary}"/>

                <!-- ── TÉRMINOS, CONDICIONES Y AVISO LEGAL ── -->
                <Grid Margin="0,40,0,36" MaxWidth="820" HorizontalAlignment="Left"
                      ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Términos, condiciones y aviso legal"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Léelos con calma — el uso de Hakufu implica su aceptación"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="§"
                               FontSize="52"
                               Foreground="{DynamicResource DividerBrush}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding LegalSections}" MaxWidth="820" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegalSection">
                            <Border Margin="0,0,0,16"
                                    Classes="card"
                                    Padding="24,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Body}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock MaxWidth="820" HorizontalAlignment="Left"
                           Text="Este texto tiene fines informativos y de protección razonable, no constituye asesoramiento jurídico profesional."
                           FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
