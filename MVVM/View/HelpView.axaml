<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.HelpView"
             x:DataType="vm:HelpViewModel">

    <!-- Guía "Cómo usar Hakufu": índice fijo a la izquierda (clic = ir a la
         sección) y el texto con capturas a la derecha. Las capturas son de la
         app real con mangas inventados: tests/Hakufu.Tests/HelpScreenshots.cs -->

    <UserControl.Styles>
        <!-- ── Índice ── -->
        <Style Selector="Button.indexItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="12,9">
                        <ContentPresenter Name="ContentHost" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.indexItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.indexItem:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="Button.indexItem.active">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.indexItem.active /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
        </Style>

        <!-- ── Texto ── -->
        <Style Selector="TextBlock.kicker">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontSemi}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="52"/>
            <Setter Property="LineHeight" Value="50"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>
        <Style Selector="TextBlock.lead">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="25"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style Selector="TextBlock.p">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.term">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <!-- Cada sección, con aire de sobra entre una y otra -->
        <Style Selector="StackPanel.section">
            <Setter Property="Margin" Value="0,0,0,88"/>
        </Style>

        <!-- Lista de puntos: término + explicación, separados por una línea fina -->
        <Style Selector="Border.feature">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,14,0,14"/>
        </Style>

        <!-- Captura: tarjeta redondeada con borde sutil -->
        <Style Selector="Border.shot">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BoxShadow" Value="0 8 28 0 #33000000"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,4,0,28"/>
        </Style>
        <Style Selector="Border.shot > Image">
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <!-- Consejo: raya a la izquierda -->
        <Style Selector="Border.tip">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="16,4,0,4"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <!-- Tecla, como en Ajustes → Atajos -->
        <Style Selector="Border.keycap">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 2 0 0 #33000000"/>
        </Style>
        <Style Selector="Border.keycap > TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Árbol de carpetas de ejemplo -->
        <Style Selector="StackPanel.treeRow">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="10"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style Selector="ContentControl.folder">
            <Setter Property="Template" Value="{StaticResource IconPixelFolder}"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Border.branch">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
            <Setter Property="Margin" Value="7,0,0,4"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
        </Style>
        <Style Selector="Border.ext">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.ext > TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.folderName">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.fileName">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <c:PageHeader Grid.Row="0"
                      Title="{i18n:T help.title}"
                      Subtitle="{i18n:T help.subtitle}"
                      BackText="{i18n:T common.back_home}"
                      BackCommand="{Binding GoBackCommand}">
        </c:PageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="272,*">

            <!-- ═══ ÍNDICE (fijo) ═══ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="28,28,24,24">

                    <ItemsControl Name="Index" ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HelpSection">
                                <Button Classes="indexItem" Classes.active="{Binding IsActive}"
                                        Click="IndexItem_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Number}" Width="20"
                                                   FontFamily="{DynamicResource DisplayFontSemi}" FontSize="13"
                                                   VerticalAlignment="Center" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ GUÍA ═══ -->
            <ScrollViewer Grid.Column="1" Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ContentPanel" MaxWidth="720" Margin="56,48,56,64"
                            HorizontalAlignment="Center">

                    <!-- ── 01 EMPEZAR ── -->
                    <StackPanel Name="SecStart" Classes="section">
                        <TextBlock Classes="kicker" Text="01"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s1.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s1.intro}"/>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s1.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s1.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s1.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s1.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1" Margin="0,0,0,28">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s1.t3.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s1.t3.text}"/>
                            </StackPanel>
                        </Border>

                        <!-- Árbol de ejemplo -->
                        <Border Classes="card" Padding="28,22" HorizontalAlignment="Left" MinWidth="440">
                            <StackPanel>
                                <TextBlock Classes="label" Text="{i18n:T help.s1.example}" Margin="0,0,0,12"/>

                                <StackPanel Classes="treeRow">
                                    <ContentControl Classes="folder"/>
                                    <TextBlock Classes="folderName" Text="{i18n:T help.s1.tree.root}"/>
                                    <TextBlock Classes="note" Text="{i18n:T help.s1.tree.root_note}"/>
                                </StackPanel>
                                <Border Classes="branch">
                                    <StackPanel>
                                        <StackPanel Classes="treeRow">
                                            <ContentControl Classes="folder"/>
                                            <TextBlock Classes="folderName" Text="{i18n:T help.s1.tree.series1}"/>
                                            <TextBlock Classes="note" Text="{i18n:T help.s1.tree.collection_note}"/>
                                        </StackPanel>
                                        <Border Classes="branch">
                                            <StackPanel>
                                                <StackPanel Classes="treeRow">
                                                    <Border Classes="ext"><TextBlock Text="{i18n:T help.s1.tree.ext_cbz}"/></Border>
                                                    <TextBlock Classes="fileName" Text="{i18n:T help.s1.tree.series1_vol1}"/>
                                                    <TextBlock Classes="note" Text="{i18n:T help.s1.tree.volume_note}"/>
                                                </StackPanel>
                                                <StackPanel Classes="treeRow">
                                                    <Border Classes="ext"><TextBlock Text="{i18n:T help.s1.tree.ext_cbz}"/></Border>
                                                    <TextBlock Classes="fileName" Text="{i18n:T help.s1.tree.series1_vol2}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Classes="treeRow">
                                            <ContentControl Classes="folder"/>
                                            <TextBlock Classes="folderName" Text="{i18n:T help.s1.tree.series2}"/>
                                        </StackPanel>
                                        <Border Classes="branch">
                                            <StackPanel>
                                                <StackPanel Classes="treeRow">
                                                    <Border Classes="ext"><TextBlock Text="{i18n:T help.s1.tree.ext_pdf}"/></Border>
                                                    <TextBlock Classes="fileName" Text="{i18n:T help.s1.tree.series2_vol1}"/>
                                                </StackPanel>
                                                <StackPanel Classes="treeRow">
                                                    <Border Classes="ext"><TextBlock Text="{i18n:T help.s1.tree.ext_cbr}"/></Border>
                                                    <TextBlock Classes="fileName" Text="{i18n:T help.s1.tree.series2_vol2}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Classes="treeRow">
                                            <ContentControl Classes="folder"/>
                                            <TextBlock Classes="folderName" Text="{i18n:T help.s1.tree.series3}"/>
                                        </StackPanel>
                                        <Border Classes="branch" Margin="7,0,0,0">
                                            <StackPanel Classes="treeRow">
                                                <Border Classes="ext"><TextBlock Text="{i18n:T help.s1.tree.ext_cbz}"/></Border>
                                                <TextBlock Classes="fileName" Text="{i18n:T help.s1.tree.series3_vol1}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="p" Margin="0,24,0,0"
                                   Text="{i18n:T help.s1.outro}"/>
                        <Border Classes="tip">
                            <TextBlock Classes="p"
                                       Text="{i18n:T help.s1.tip}"/>
                        </Border>
                        <Button Classes="primary" Content="{i18n:T help.s1.go_settings}" HorizontalAlignment="Left"
                                Padding="20,10" Margin="0,28,0,0"
                                Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>

                    <!-- ── 02 BIBLIOTECA ── -->
                    <StackPanel Name="SecLibrary" Classes="section">
                        <TextBlock Classes="kicker" Text="02"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s2.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s2.intro}"/>
                        <Border Classes="shot">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/library.png"/>
                        </Border>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s2.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s2.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s2.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s2.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s2.t3.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s2.t3.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s2.t4.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s2.t4.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1" Margin="0,0,0,28">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s2.t5.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s2.t5.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="shot">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/collection.png"/>
                        </Border>
                    </StackPanel>

                    <!-- ── 03 LEER ── -->
                    <StackPanel Name="SecReader" Classes="section">
                        <TextBlock Classes="kicker" Text="03"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s3.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s3.intro}"/>
                        <Border Classes="shot">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/reader.png"/>
                        </Border>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s3.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s3.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s3.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s3.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s3.t3.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s3.t3.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1" Margin="0,0,0,28">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s3.t4.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s3.t4.text}"/>
                            </StackPanel>
                        </Border>

                        <!-- Atajos actuales -->
                        <Border Classes="card" Padding="0" ClipToBounds="True">
                            <StackPanel>
                                <StackPanel Margin="24,20,24,12">
                                    <TextBlock Classes="label" Text="{i18n:T help.s3.shortcuts}"/>
                                    <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="{i18n:T help.s3.shortcuts_hint}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Shortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HelpShortcut">
                                            <Border Padding="24,10" BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="keycap">
                                                                    <TextBlock Text="{Binding}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 04 INICIO ── -->
                    <StackPanel Name="SecHome" Classes="section">
                        <TextBlock Classes="kicker" Text="04"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s4.title}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                <TextBlock Classes="lead"
                                           Text="{i18n:T help.s4.intro}"/>
                                <TextBlock Classes="p"
                                           Text="{i18n:T help.s4.p1}"/>
                                <TextBlock Classes="p" Margin="0,14,0,0"
                                           Text="{i18n:T help.s4.p2}"/>
                                <Button Classes="ghost" Content="{i18n:T help.s4.go_library}" HorizontalAlignment="Left"
                                        Padding="18,10" Margin="0,24,0,0"
                                        Command="{Binding OpenLibraryCommand}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="shot" Width="280" Margin="0,4,0,0"
                                    VerticalAlignment="Top">
                                <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/home.png"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ── 05 PERFIL ── -->
                    <StackPanel Name="SecProfile" Classes="section">
                        <TextBlock Classes="kicker" Text="05"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s5.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s5.intro}"/>
                        <Border Classes="shot">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/profile.png"/>
                        </Border>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s5.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s5.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s5.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s5.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s5.t3.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s5.t3.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s5.t4.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s5.t4.text}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 06 AJUSTES ── -->
                    <StackPanel Name="SecSettings" Classes="section">
                        <TextBlock Classes="kicker" Text="06"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s6.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s6.intro}"/>
                        <Border Classes="shot" MaxWidth="560">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/settings.png"/>
                        </Border>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t3.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t3.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t4.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t4.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t5.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t5.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s6.t6.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s6.t6.text}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 07 COPIA DE SEGURIDAD ── -->
                    <StackPanel Name="SecBackup" Classes="section">
                        <TextBlock Classes="kicker" Text="07"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s7.title}"/>
                        <TextBlock Classes="lead"
                                   Text="{i18n:T help.s7.intro}"/>
                        <Border Classes="shot" MaxWidth="560">
                            <Image RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://Hakufu/Assets/Help/backup.png"/>
                        </Border>

                        <Border Classes="feature">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s7.t1.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s7.t1.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="feature" BorderThickness="0,1,0,1">
                            <StackPanel>
                                <TextBlock Classes="term" Text="{i18n:T help.s7.t2.term}"/>
                                <TextBlock Classes="p" Text="{i18n:T help.s7.t2.text}"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="tip">
                            <TextBlock Classes="p"
                                       Text="{i18n:T help.s7.tip}"/>
                        </Border>
                        <Button Classes="ghost" Content="{i18n:T help.s7.go_backup}" HorizontalAlignment="Left"
                                Padding="18,10" Margin="0,28,0,0"
                                Command="{Binding OpenBackupCommand}"/>
                    </StackPanel>

                    <!-- ── 08 PREGUNTAS FRECUENTES ── -->
                    <StackPanel Name="SecFaq" Classes="section" Margin="0">
                        <TextBlock Classes="kicker" Text="08"/>
                        <TextBlock Classes="h2" Text="{i18n:T help.s8.title}"/>
                        <ItemsControl ItemsSource="{Binding Questions}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HelpQuestion">
                                    <Border Classes="feature" Padding="0,18,0,20">
                                        <StackPanel>
                                            <TextBlock Classes="term" FontSize="15" Text="{Binding Question}"
                                                       Margin="0,0,0,6"/>
                                            <TextBlock Classes="p" Text="{Binding Answer}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
