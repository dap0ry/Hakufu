<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="using:Hakufu.I18n"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>

        <!-- ── Entrada del menú ──────────────────────────────────────────
             Rótulo grande en condensada. Al pasar el ratón (o con el foco del
             teclado) una franja inclinada del color del texto (blanca en tema
             oscuro, negra en claro) crece desde la izquierda por
             detrás del texto y el texto se desplaza un poco: el mismo gesto
             que los menús de manga/Persona.
-->
        <Style Selector="Button.menuItem">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding"             Value="18,4,26,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Slab"
                                Background="{DynamicResource TextPrimary}"
                                RenderTransformOrigin="0%,50%"
                                RenderTransform="skewX(-12deg) scaleX(0)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="ItemContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          RenderTransform="translateX(0px)">
                            <ContentPresenter.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                </Transitions>
                            </ContentPresenter.Transitions>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.menuItem:pointerover, Button.menuItem:focus-visible">
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}"/>
        </Style>
        <Style Selector="Button.menuItem:pointerover /template/ Border#Slab, Button.menuItem:focus-visible /template/ Border#Slab">
            <Setter Property="RenderTransform" Value="skewX(-12deg) scaleX(1)"/>
        </Style>
        <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter#ItemContent, Button.menuItem:focus-visible /template/ ContentPresenter#ItemContent">
            <Setter Property="RenderTransform" Value="translateX(12px)"/>
        </Style>
        <Style Selector="Button.menuItem:pressed /template/ ContentPresenter#ItemContent">
            <Setter Property="RenderTransform" Value="translateX(8px)"/>
        </Style>

        <!-- Foto de perfil junto a "Perfil": círculo con un aro del color del texto
             (blanco en oscuro, negro en claro; al pasar el ratón, el del fondo). -->
        <Style Selector="Border.menuAvatar">
            <Setter Property="Width"             Value="44"/>
            <Setter Property="Height"            Value="44"/>
            <Setter Property="CornerRadius"      Value="22"/>
            <Setter Property="ClipToBounds"      Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,2,0,0"/>
            <Setter Property="BorderThickness"   Value="2"/>
            <Setter Property="BorderBrush"       Value="{Binding $parent[Button].Foreground}"/>
            <Setter Property="BoxShadow"         Value="0 4 14 0 #40000000"/>
        </Style>
        <Style Selector="Border.menuAvatar.initial">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <Style Selector="TextBlock.menuLabel">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize"   Value="44"/>
            <Setter Property="LineHeight" Value="46"/>
        </Style>
        <Style Selector="Button.big TextBlock.menuLabel">
            <Setter Property="FontSize"   Value="76"/>
            <Setter Property="LineHeight" Value="76"/>
        </Style>


        <!-- ── Continuar leyendo: grande a la derecha; en iPhone, barra abajo ── -->
        <Style Selector="Grid#MenuGrid">
            <Setter Property="Margin" Value="48,40,32,28"/>
        </Style>
        <Style Selector="Grid#ContinuePanel">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <Style Selector="Grid#ContinueCard">
            <Setter Property="Width" Value="300"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid#ContinueCard > :is(Control).continueText">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Border#ContinueCover">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Width" Value="236"/>
            <Setter Property="Height" Value="334"/>
            <Setter Property="Margin" Value="8,0,0,40"/>
            <Setter Property="BoxShadow" Value="12 12 0 0 #E5001A"/>
        </Style>
        <Style Selector="TextBlock#ContinueTitle">
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="LineHeight" Value="44"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="Margin" Value="0,2,0,14"/>
        </Style>
        <Style Selector="Button#ContinueButton">
            <Setter Property="Padding" Value="26,11"/>
            <Setter Property="Margin" Value="0,22,0,0"/>
        </Style>

        <!-- iPad en vertical e iPhone (MainView.narrow): una columna; el menú arriba y
             la barra de «Continuar leyendo» abajo. En iPhone (compact), además, letra
             más pequeña. -->
        <Style Selector=".narrow Border#MenuPanel">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector=".compact Grid#MenuGrid">
            <Setter Property="Margin" Value="24,20,24,16"/>
        </Style>
        <Style Selector=".compact TextBlock.menuLabel">
            <Setter Property="FontSize"   Value="34"/>
            <Setter Property="LineHeight" Value="36"/>
        </Style>
        <Style Selector=".compact Button.big TextBlock.menuLabel">
            <Setter Property="FontSize"   Value="52"/>
            <Setter Property="LineHeight" Value="52"/>
        </Style>
        <!-- Sin nada empezado no hay barra (Biblioteca ya está en el menú) -->
        <Style Selector=".narrow Grid#ContinuePanel" x:DataType="vm:HomeViewModel">
            <Setter Property="IsVisible" Value="{Binding HasLastManga}"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Height" Value="150"/>
        </Style>
        <Style Selector=".narrow Panel#HomeEmpty">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector=".narrow Grid#ContinueCard">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="24,0"/>
        </Style>
        <Style Selector=".narrow Border#ContinueCover">
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Grid.RowSpan" Value="5"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="102"/>
            <Setter Property="Margin" Value="4,0,22,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BoxShadow" Value="6 6 0 0 #E5001A"/>
        </Style>
        <Style Selector=".narrow Grid#ContinueCard > :is(Control).continueText">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
        </Style>
        <Style Selector=".narrow TextBlock#ContinueTitle">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="LineHeight" Value="26"/>
            <Setter Property="MaxLines" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector=".narrow Button#ContinueButton">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

    </UserControl.Styles>

    <Grid ColumnDefinitions="5*,6*" RowDefinitions="*,Auto">

        <!-- ═══ IZQUIERDA — logo + menú ═══ -->
        <Border Grid.Column="0" Name="MenuPanel"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Name="MenuGrid" RowDefinitions="Auto,*,Auto">

                <!-- Título -->
                <TextBlock Grid.Row="0"
                           Text="Hakufu"
                           FontSize="44" FontWeight="Black"
                           LetterSpacing="-1.5"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2" Margin="-18,24,0,24">
                    <!-- Biblioteca -->
                    <Button Classes="menuItem big" Command="{Binding NavLibraryCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="{i18n:T home.library}"/>
                        </StackPanel>
                    </Button>
                    <!-- Perfil -->
                    <Button Classes="menuItem" Command="{Binding NavProfileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Classes="menuLabel" Text="{i18n:T home.profile}"/>
                            <!-- Tu foto, en círculo; con la inicial si no hay foto -->
                            <Border Classes="menuAvatar"
                                    IsVisible="{Binding HasProfileAvatar}">
                                <Image Source="{Binding ProfileAvatar}" Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </Border>
                            <Border Classes="menuAvatar initial"
                                    IsVisible="{Binding ShowProfileInitial}">
                                <TextBlock Text="{Binding ProfileInitial}"
                                           FontFamily="{DynamicResource DisplayFont}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- Copia de seguridad -->
                    <Button Classes="menuItem" Command="{Binding NavBackupCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="{i18n:T home.backup}"/>
                        </StackPanel>
                    </Button>
                    <!-- Ajustes -->
                    <Button Classes="menuItem" Command="{Binding NavSettingsCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="{i18n:T home.settings}"/>
                        </StackPanel>
                    </Button>
                    <!-- Ayuda -->
                    <Button Classes="menuItem" Command="{Binding NavHelpCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="{i18n:T home.help}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sin enlace: la app no abre URLs de red -->
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{i18n:T home.credit_dev}"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="{i18n:T home.credit_design}"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="16"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ DERECHA — continuar leyendo ═══ -->
        <Grid Name="ContinuePanel" Background="{DynamicResource AppBackground}" ClipToBounds="True">

            <!-- Estado vacío (en iPhone no: Biblioteca ya está en el menú) -->
            <Panel Name="HomeEmpty">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="340" Spacing="12"
                        IsVisible="{Binding !HasLastManga}">
                <TextBlock Text="{i18n:T home.empty_title}"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="64" LineHeight="62"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{i18n:T home.empty_body}"
                           TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Button Classes="primary"
                        Content="{i18n:T home.go_library}"
                        HorizontalAlignment="Left"
                        Padding="24,11" Margin="0,12,0,0"
                        Command="{Binding NavLibraryCommand}"/>
            </StackPanel>
            </Panel>

            <!-- Manga en curso -->
            <Grid IsVisible="{Binding HasLastManga}">

                <!-- La portada, desenfocada, tiñe todo el panel -->
                <Image Source="{Binding LastMangaCover}"
                       Stretch="UniformToFill"
                       Opacity="0.45"
                       RenderTransformOrigin="50%,50%"
                       RenderTransform="scale(1.25)"
                       RenderOptions.BitmapInterpolationMode="LowQuality">
                    <Image.Effect>
                        <BlurEffect Radius="60"/>
                    </Image.Effect>
                </Image>
                <Border Background="{DynamicResource AppBackground}" Opacity="0.55"/>

                <Grid Name="ContinueCard" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <!-- Portada con sombra dura roja. La sombra va en el Border de
                         fuera: el de dentro recorta la imagen. -->
                    <Border Name="ContinueCover"
                            HorizontalAlignment="Left"
                            RenderTransform="rotate(-3deg)">
                        <Border Background="{DynamicResource CardBackground}" ClipToBounds="True">
                            <Image Source="{Binding LastMangaCover}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>
                    </Border>

                    <TextBlock Grid.Row="1" Classes="continueText"
                               Text="{i18n:T home.continue_label}"
                               FontFamily="{DynamicResource DisplayFontSemi}"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Name="ContinueTitle" Grid.Row="2" Classes="continueText"
                               Text="{Binding LastMangaTitle}"
                               FontFamily="{DynamicResource DisplayFont}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <StackPanel Grid.Row="3" Classes="continueText" Spacing="6" IsVisible="{Binding LastMangaPageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LastMangaPageText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ProgressBar Value="{Binding LastMangaProgress}" Maximum="100"
                                     Height="4" MinHeight="4" CornerRadius="0"
                                     Background="{DynamicResource ProgressTrack}"
                                     Foreground="{DynamicResource BrandRed}"/>
                    </StackPanel>

                    <Button Name="ContinueButton" Grid.Row="4" Classes="primary continueText"
                            Content="{i18n:T home.continue_button}"
                            HorizontalAlignment="Left"
                            Command="{Binding ContinueReadingCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
