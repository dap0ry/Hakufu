<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>

        <!-- ── Entrada del menú ──────────────────────────────────────────
             Rótulo grande en condensada. Al pasar el ratón (o con el foco del
             teclado) una franja inclinada del color del texto (blanca en tema
             oscuro, negra en claro) crece desde la izquierda por
             detrás del texto y el texto se desplaza un poco: el mismo gesto
             que los menús de manga/Persona.
-->
        <Style Selector="Button.menuItem">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding"             Value="18,4,26,6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Slab"
                                Background="{DynamicResource TextPrimary}"
                                RenderTransformOrigin="0%,50%"
                                RenderTransform="skewX(-12deg) scaleX(0)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter Name="ItemContent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          RenderTransform="translateX(0px)">
                            <ContentPresenter.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                </Transitions>
                            </ContentPresenter.Transitions>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.menuItem:pointerover, Button.menuItem:focus-visible">
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}"/>
        </Style>
        <Style Selector="Button.menuItem:pointerover /template/ Border#Slab, Button.menuItem:focus-visible /template/ Border#Slab">
            <Setter Property="RenderTransform" Value="skewX(-12deg) scaleX(1)"/>
        </Style>
        <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter#ItemContent, Button.menuItem:focus-visible /template/ ContentPresenter#ItemContent">
            <Setter Property="RenderTransform" Value="translateX(12px)"/>
        </Style>
        <Style Selector="Button.menuItem:pressed /template/ ContentPresenter#ItemContent">
            <Setter Property="RenderTransform" Value="translateX(8px)"/>
        </Style>

        <Style Selector="TextBlock.menuLabel">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize"   Value="44"/>
            <Setter Property="LineHeight" Value="46"/>
        </Style>
        <Style Selector="Button.big TextBlock.menuLabel">
            <Setter Property="FontSize"   Value="76"/>
            <Setter Property="LineHeight" Value="76"/>
        </Style>
        <Style Selector="TextBlock.menuCaption">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity"  Value="0.65"/>
            <Setter Property="Margin"   Value="2,0,0,4"/>
        </Style>


    </UserControl.Styles>

    <Grid ColumnDefinitions="5*,6*">

        <!-- ═══ IZQUIERDA — logo + menú ═══ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="48,40,32,28" RowDefinitions="Auto,*,Auto">

                <!-- Título (imagen distinta en cada tema, ver TitleBrush) -->
                <Border Grid.Row="0"
                        Width="300" Height="92"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TitleBrush}"
                        RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2" Margin="-18,24,0,24">
                    <!-- Biblioteca -->
                    <Button Classes="menuItem big" Command="{Binding NavLibraryCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="Biblioteca"/>
                            <TextBlock Classes="menuCaption" Text="Tus colecciones y mangas"/>
                        </StackPanel>
                    </Button>
                    <!-- Perfil -->
                    <Button Classes="menuItem" Command="{Binding NavProfileCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="Perfil"/>
                        </StackPanel>
                    </Button>
                    <!-- Copia de seguridad -->
                    <Button Classes="menuItem" Command="{Binding NavBackupCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="Copia de seguridad"/>
                        </StackPanel>
                    </Button>
                    <!-- Ajustes -->
                    <Button Classes="menuItem" Command="{Binding NavSettingsCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="Ajustes"/>
                        </StackPanel>
                    </Button>
                    <!-- Ayuda -->
                    <Button Classes="menuItem" Command="{Binding NavHelpCommand}">
                        <StackPanel>
                            <TextBlock Classes="menuLabel" Text="Ayuda"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Sin enlace: la app no abre URLs de red -->
                <TextBlock Grid.Row="2"
                           Text="por Daniel Poza Rivera"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11"/>
            </Grid>
        </Border>

        <!-- ═══ DERECHA — continuar leyendo ═══ -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBackground}" ClipToBounds="True">

            <!-- Estado vacío -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="340" Spacing="12"
                        IsVisible="{Binding !HasLastManga}">
                <TextBlock Text="Nada a medias"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="64" LineHeight="62"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Abre la biblioteca, añade tus tomos y aquí te esperará el último que estés leyendo."
                           TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Button Classes="primary"
                        Content="Ir a la biblioteca"
                        HorizontalAlignment="Left"
                        Padding="24,11" Margin="0,12,0,0"
                        Command="{Binding NavLibraryCommand}"/>
            </StackPanel>

            <!-- Manga en curso -->
            <Grid IsVisible="{Binding HasLastManga}">

                <!-- La portada, desenfocada, tiñe todo el panel -->
                <Image Source="{Binding LastMangaCover}"
                       Stretch="UniformToFill"
                       Opacity="0.45"
                       RenderTransformOrigin="50%,50%"
                       RenderTransform="scale(1.25)"
                       RenderOptions.BitmapInterpolationMode="LowQuality">
                    <Image.Effect>
                        <BlurEffect Radius="60"/>
                    </Image.Effect>
                </Image>
                <Border Background="{DynamicResource AppBackground}" Opacity="0.55"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

                    <!-- Portada con sombra dura roja. La sombra va en el Border de
                         fuera: el de dentro recorta la imagen. -->
                    <Border Width="236" Height="334"
                            BoxShadow="12 12 0 0 #E5001A"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,40"
                            RenderTransform="rotate(-3deg)">
                        <Border Background="{DynamicResource CardBackground}" ClipToBounds="True">
                            <Image Source="{Binding LastMangaCover}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>
                    </Border>

                    <TextBlock Text="Continuar leyendo"
                               FontFamily="{DynamicResource DisplayFontSemi}"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding LastMangaTitle}"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="46" LineHeight="44"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,2,0,14"/>

                    <StackPanel Spacing="6" IsVisible="{Binding LastMangaPageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LastMangaPageText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ProgressBar Value="{Binding LastMangaProgress}" Maximum="100"
                                     Height="4" MinHeight="4" CornerRadius="0"
                                     Background="{DynamicResource ProgressTrack}"
                                     Foreground="{DynamicResource BrandRed}"/>
                    </StackPanel>

                    <Button Classes="primary"
                            Content="Seguir leyendo"
                            HorizontalAlignment="Left"
                            Padding="26,11" Margin="0,22,0,0"
                            Command="{Binding ContinueReadingCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
