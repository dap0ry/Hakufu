<UserControl x:Class="Hakufu.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ── Tile de navegación: icono vectorial + etiqueta, resalta en hover ── -->
        <Style x:Key="NavTile" TargetType="Button">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="BorderBrush"        Value="{DynamicResource CardBorder}"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"             Value="18,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fondo de icono: cuadrado redondeado con tinte de acento.
             OJO: Opacity va solo en el fondo — si el icono va DENTRO de este
             Border como hijo, hereda la opacidad y queda casi invisible.
             El icono debe ir como hermano encima, en un Grid, no como hijo. -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width"   Value="40"/>
            <Setter Property="Height"  Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Opacity" Value="0.14"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52*"/>  <!-- Left — nav -->
            <ColumnDefinition Width="48*"/>  <!-- Right — continue reading -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- LEFT  — título + navegación                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="56,40,56,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- title -->
                    <RowDefinition Height="Auto"/>   <!-- hero actions -->
                    <RowDefinition Height="*"/>       <!-- tile grid -->
                    <RowDefinition Height="Auto"/>   <!-- footer -->
                </Grid.RowDefinitions>

                <!-- ── TÍTULO ── -->
                <StackPanel Grid.Row="0" Margin="0,0,0,36">
                    <TextBlock FontFamily="Segoe UI">
                        <Run Text="HAKU" FontSize="52" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                        <Run Text="FU"   FontSize="52" FontWeight="Black" Foreground="{DynamicResource AccentColor}"/>
                    </TextBlock>
                    <Rectangle Height="4" Width="56" HorizontalAlignment="Left"
                               Fill="{DynamicResource AccentColor}" Margin="2,6,0,0"/>
                    <TextBlock Text="Tu biblioteca de manga"
                               FontSize="13" Foreground="{DynamicResource TextMuted}"
                               Margin="2,10,0,0"/>
                </StackPanel>

                <!-- ── ACCIÓN PRINCIPAL ── -->
                <Button Grid.Row="1" Style="{StaticResource NavTile}"
                        Command="{Binding NavLibraryCommand}"
                        Margin="0,0,0,10" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="48" Height="48">
                            <Border Style="{StaticResource IconBadge}" Width="48" Height="48" Opacity="0.18"/>
                            <ContentControl Template="{StaticResource IconPixelBooks}"
                                            Width="24" Height="24"
                                            Foreground="{DynamicResource AccentColor}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="Biblioteca" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Tus colecciones y mangas" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ── CUADRÍCULA DE ACCESOS ── -->
                <UniformGrid Grid.Row="2" Columns="2" Rows="3" Margin="0,16,0,0">

                    <!-- Perfil -->
                    <Button Style="{StaticResource NavTile}" Command="{Binding NavProfileCommand}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40">
                                <Border Style="{StaticResource IconBadge}"/>
                                <ContentControl Template="{StaticResource IconPixelHanko}"
                                                Width="18" Height="18"
                                                Foreground="{DynamicResource AccentColor}"/>
                            </Grid>
                            <TextBlock Text="Perfil" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Amigos -->
                    <Button Style="{StaticResource NavTile}" Command="{Binding NavFriendsCommand}" Margin="6,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40">
                                <Border Style="{StaticResource IconBadge}"/>
                                <ContentControl Template="{StaticResource IconPixelFriends}"
                                                Width="18" Height="18"
                                                Foreground="{DynamicResource AccentColor}"/>
                            </Grid>
                            <TextBlock Text="Amigos" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Ajustes -->
                    <Button Style="{StaticResource NavTile}" Command="{Binding NavSettingsCommand}" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40">
                                <Border Style="{StaticResource IconBadge}"/>
                                <ContentControl Template="{StaticResource IconPixelLantern}"
                                                Width="18" Height="18"
                                                Foreground="{DynamicResource AccentColor}"/>
                            </Grid>
                            <TextBlock Text="Ajustes" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Ayuda -->
                    <Button Style="{StaticResource NavTile}" Command="{Binding NavHelpCommand}" Margin="6,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40">
                                <Border Style="{StaticResource IconBadge}"/>
                                <TextBlock Text="?" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Ayuda" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Cuenta (avatar real si hay sesión) -->
                    <Button Style="{StaticResource NavTile}" Command="{Binding NavAccountCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="40"
                                  Visibility="{Binding ShowAvatarArea, Converter={StaticResource BoolToVisibility}}">
                                <Border CornerRadius="20" ClipToBounds="True"
                                        Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                    <Image Source="{Binding AvatarUrl, Converter={StaticResource UrlToImage}}"
                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Border CornerRadius="20" Background="{DynamicResource AccentColor}" Opacity="0.18"
                                        Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <TextBlock Text="{Binding SessionInitial}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </Grid>
                            <Grid Width="40" Height="40"
                                  Visibility="{Binding ShowAvatarArea, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Style="{StaticResource IconBadge}"/>
                                <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="4" Canvas.Top="0" Width="8" Height="8" Fill="{DynamicResource AccentColor}"/>
                                    <Path Data="M 0,16 C 0,11 16,11 16,16" Fill="{DynamicResource AccentColor}"/>
                                </Canvas>
                            </Grid>
                            <TextBlock Text="{Binding SessionLabel}" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>

                <!-- ── FOOTER ── -->
                <TextBlock Grid.Row="3"
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="11"
                           Margin="0,20,0,0">
                    <Hyperlink NavigateUri="https://danielpozarivera.es/"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{DynamicResource TextMuted}"
                               TextDecorations="None">
                        por Daniel Poza Rivera
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- RIGHT  — continuar leyendo                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource AppBackground}" ClipToBounds="True">

            <!-- Patrón decorativo de fondo: círculos suaves con el color de acento -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Right="-120" Canvas.Top="-120" Width="360" Height="360"
                         Fill="{DynamicResource AccentColor}" Opacity="0.05"/>
                <Ellipse Canvas.Right="40" Canvas.Bottom="-160" Width="300" Height="300"
                         Fill="{DynamicResource AccentColor}" Opacity="0.04"/>
            </Canvas>

            <!-- Estado vacío -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasLastManga, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="{DynamicResource AccentColor}" Opacity="0.12"
                        HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Sin lectura reciente"
                           Style="{StaticResource SubtitleText}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Abre Biblioteca para empezar a leer"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Manga en curso -->
            <Grid Visibility="{Binding HasLastManga, Converter={StaticResource BoolToVisibility}}">

                <!-- Portada difuminada de fondo (decorativa) -->
                <Image Source="{Binding LastMangaCover}"
                       Stretch="UniformToFill"
                       Opacity="0.07"
                       RenderOptions.BitmapScalingMode="LowQuality"/>

                <!-- Degradado sobre el fondo -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#55000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Contenido centrado -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="280">

                    <!-- Portada principal (flotante) -->
                    <Border Width="220" Height="310"
                            CornerRadius="6"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" ShadowDepth="0"
                                              BlurRadius="40" Opacity="0.32"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <RotateTransform Angle="-1.5" CenterX="110" CenterY="155"/>
                        </Border.RenderTransform>
                        <Image Source="{Binding LastMangaCover}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Etiqueta -->
                    <TextBlock Text="CONTINUAR LEYENDO"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Título -->
                    <TextBlock Text="{Binding LastMangaTitle}"
                               FontSize="17"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Botón -->
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Continuar leyendo"
                            HorizontalAlignment="Center"
                            Padding="28,11"
                            Command="{Binding ContinueReadingCommand}"/>

                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
