<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             x:Class="Hakufu.MVVM.View.LegalView"
             x:DataType="vm:LegalViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <c:PageHeader Grid.Row="0"
                      Title="Aviso legal"
                      Subtitle="Términos, condiciones y privacidad"
                      BackText="← Ajustes"
                      BackCommand="{Binding GoBackCommand}">
        </c:PageHeader>

        <!-- ═══ TEXTO ═══ Una columna estrecha, para leer con calma -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" Margin="40,48,40,64" HorizontalAlignment="Center">

                <TextBlock Text="Usar Hakufu implica aceptar estos términos. Léelos con calma."
                           FontSize="14" LineHeight="22" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,28"/>

                <ItemsControl ItemsSource="{Binding LegalSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LegalSection">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                    Padding="0,26,0,30">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding Body}"
                                               FontSize="14" LineHeight="24"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <TextBlock Text="Este texto tiene fines informativos y de protección razonable, no constituye asesoramiento jurídico profesional."
                               FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
