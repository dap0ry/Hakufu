<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <!-- Tarjeta de colección: sin cromo; al pasar el ratón el montón sube un poco -->
        <Style Selector="Button.collectionCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="Transparent">
                        <ContentPresenter Name="ContentHost"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.collectionCard Grid#Stack">
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.collectionCard:pointerover Grid#Stack">
            <Setter Property="RenderTransform" Value="translateY(-6px)"/>
        </Style>

        <!-- Estrella: solo al pasar el ratón, o siempre si ya es favorita -->
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="ContentHost"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.collectionCard:pointerover Button.star, Button.star.isFavorite">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ContentControl.starIcon">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>
        <Style Selector="ContentControl.starIcon.favorite">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Cada portada del montón: como una foto, con su sombra -->
        <Style Selector="Border.photo">
            <Setter Property="Background"      Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="ClipToBounds"    Value="True"/>
            <Setter Property="BoxShadow"       Value="0 4 14 0 #40000000"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <Border Grid.Row="0" Padding="40,26,40,22"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="ghost" Content="← Inicio"
                        VerticalAlignment="Center"
                        Command="{Binding GoBackCommand}"/>

                <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Biblioteca"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="52" LineHeight="50"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="12" Margin="1,4,0,0"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Normal -->
                    <Button Classes="ghost" Content="Seleccionar" Padding="16,10"
                            Command="{Binding ToggleSelectionModeCommand}"
                            IsVisible="{Binding !IsSelectionMode}"/>
                    <Button Classes="primary" Content="Nueva colección" Padding="18,10"
                            Command="{Binding CreateCollectionCommand}"
                            IsVisible="{Binding !IsSelectionMode}"/>
                    <!-- Selección -->
                    <Button Classes="ghost" Content="Cancelar" Padding="16,10"
                            Command="{Binding ToggleSelectionModeCommand}"
                            IsVisible="{Binding IsSelectionMode}"/>
                    <Button Classes="primary" Padding="18,10"
                            Content="{Binding SelectedCount, StringFormat='Eliminar ({0})'}"
                            Command="{Binding DeleteSelectedCommand}"
                            IsVisible="{Binding IsSelectionMode}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ COLECCIONES ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Panel>
                <!-- Vacía -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="360" Spacing="12" Margin="40,80"
                            IsVisible="{Binding IsEmpty}">
                    <TextBlock Text="Tu estantería está vacía"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="48" LineHeight="46" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Crea una colección por serie y añade tus tomos en PDF, CBR o CBZ."
                               TextWrapping="Wrap" FontSize="14"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Button Classes="primary" Content="Nueva colección" HorizontalAlignment="Left"
                            Padding="22,11" Margin="0,12,0,0"
                            Command="{Binding CreateCollectionCommand}"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Collections}" Margin="34,36,34,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CollectionCardViewModel">
                            <Button Classes="collectionCard"
                                    Margin="6,0,30,40"
                                    Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).CardClickCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Width="190">

                                    <!-- Montón como fotos apiladas: hasta 4 portadas centradas,
                                         las de detrás giradas una a cada lado, la de delante recta -->
                                    <Grid Name="Stack" Width="190" Height="262">
                                        <Border Classes="photo" Width="150" Height="222"
                                                RenderTransform="rotate(-10deg)"
                                                IsVisible="{Binding Cover4, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Panel>
                                                <Image Source="{Binding Cover4}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <Border Background="Black" Opacity="0.30"/>
                                            </Panel>
                                        </Border>
                                        <Border Classes="photo" Width="150" Height="222"
                                                RenderTransform="rotate(7deg)"
                                                IsVisible="{Binding Cover3, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Panel>
                                                <Image Source="{Binding Cover3}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <Border Background="Black" Opacity="0.22"/>
                                            </Panel>
                                        </Border>
                                        <Border Classes="photo" Width="150" Height="222"
                                                RenderTransform="rotate(-4deg)"
                                                IsVisible="{Binding Cover2, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <Panel>
                                                <Image Source="{Binding Cover2}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <Border Background="Black" Opacity="0.12"/>
                                            </Panel>
                                        </Border>

                                        <!-- Delante: portada + selección + estrella -->
                                        <Grid Width="150" Height="222">
                                            <Border Classes="photo">
                                                <Image Source="{Binding Cover1}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                            <Border CornerRadius="4"
                                                    Background="{DynamicResource AccentColor}" Opacity="0.25"
                                                    IsVisible="{Binding IsSelected}"/>
                                            <Border Width="26" Height="26" CornerRadius="13"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Background="{DynamicResource AccentColor}"
                                                    IsVisible="{Binding IsSelected}">
                                                <TextBlock Text="✓" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource AppBackground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Classes="star"
                                                    Classes.isFavorite="{Binding IsFavorite}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8,8,0,0"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    ToolTip.Tip="Colección favorita">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#80000000">
                                                    <ContentControl Classes="starIcon"
                                                                    Classes.favorite="{Binding IsFavorite}"
                                                                    Template="{StaticResource IconPixelStar}"
                                                                    Width="14" Height="14"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <!-- Nombre + datos -->
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{DynamicResource DisplayFontSemi}"
                                               FontSize="21" LineHeight="22"
                                               MaxLines="2" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="20,10,20,0"/>
                                    <TextBlock Text="{Binding CountText}"
                                               FontSize="12" Margin="20,3,20,0"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <ProgressBar Value="{Binding ProgressPct}" Maximum="100"
                                                 Width="150" MinWidth="0" HorizontalAlignment="Left"
                                                 Height="3" MinHeight="3" CornerRadius="0" Margin="20,10,0,0"
                                                 Background="{DynamicResource ProgressTrack}"
                                                 Foreground="{DynamicResource ProgressFill}"
                                                 IsVisible="{Binding HasProgress}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
