<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:model="using:Hakufu.MVVM.Model"
             x:Class="Hakufu.MVVM.View.MangaPickerView"
             x:DataType="vm:MangaPickerViewModel">

    <StackPanel MinWidth="380" MaxHeight="480">
        <TextBlock Text="Elegir manga favorito"
                   Classes="subtitle"
                   Margin="0,0,0,16"/>

        <!-- Manga list as buttons -->
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Mangas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:Manga">
                        <Button Classes="ghost"
                                HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Command="{Binding $parent[UserControl].((vm:MangaPickerViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Classes="ghost"
                Content="Cancelar"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Command="{Binding CancelCommand}"/>
    </StackPanel>
</UserControl>
