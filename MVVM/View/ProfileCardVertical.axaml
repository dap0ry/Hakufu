<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.ProfileCardVertical"
             x:DataType="vm:ProfileViewModel">

    <!-- Tarjeta de perfil en vertical (para el móvil / historias). No se ve en la app: solo se exporta. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Hakufu/MVVM/View/ProfileCardStyles.axaml"/>
    </UserControl.Styles>

    <Border Name="Card" Classes="card" Width="620" Padding="40,40,40,32">
        <StackPanel>
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="116" Height="116" CornerRadius="58"
                        Background="#2A2A2A"
                        BorderBrush="{StaticResource CardText}" BorderThickness="3"
                        ClipToBounds="True" HorizontalAlignment="Left">
                    <Panel>
                        <TextBlock Text="{Binding Initial}"
                                   IsVisible="{Binding !HasAvatar}"
                                   FontFamily="{DynamicResource DisplayFont}" FontSize="58"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                               IsVisible="{Binding HasAvatar}"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Panel>
                </Border>
                <Panel Grid.Column="1">
                <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="56" LineHeight="54"
                               TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Opacity="{Binding HasName, Converter={StaticResource BoolToOpacity}}"/>
                    <TextBlock Classes="label" Text="{Binding MemberSinceText}" Margin="2,8,0,0"/>
                </StackPanel>
                </Panel>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" Margin="0,36,0,0">
                <Panel Grid.Column="0"><StackPanel>
                        <TextBlock Classes="label" Text="{i18n:T profile.card.reading_time}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="statValue" Text="{Binding ReadingTimeValue}"/>
                            <TextBlock Classes="statUnit" Text="{Binding ReadingTimeUnit}"/>
                        </StackPanel>
                    </StackPanel></Panel>
                <Panel Grid.Column="1"><StackPanel>
                        <TextBlock Classes="label" Text="{i18n:T profile.card.pages}"/>
                        <TextBlock Classes="statValue" Text="{Binding PagesText}"/>
                    </StackPanel></Panel>
                <Panel Grid.Column="2"><StackPanel>
                        <TextBlock Classes="label" Text="{i18n:T profile.card.finished}"/>
                        <TextBlock Classes="statValue" Text="{Binding FinishedText}"/>
                    </StackPanel></Panel>
            </Grid>

            <Border Height="1" Background="{StaticResource CardLine}" Margin="0,30"/>
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                    <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{i18n:T profile.card.last_weeks}"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding ThisWeekText}"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding WeekBars}" Height="120">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WeekBarViewModel">
                            <Panel Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                                <Border Classes="bar" Height="{Binding Height}" Background="{StaticResource BarEmpty}"/>
                                <Border Classes="bar" Height="{Binding Height}" Background="{StaticResource BarIdle}"
                                        IsVisible="{Binding HasReading}"/>
                                <Border Classes="bar" Height="{Binding Height}" Background="{StaticResource CardText}"
                                        IsVisible="{Binding IsCurrent}"/>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource CardLine}"/>
                <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,0">
                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding FirstWeekLabel}"/>
                    <TextBlock Grid.Column="1" Classes="label" Text="{i18n:T profile.card.this_week}"/>
                </Grid>
                <TextBlock Classes="label" Margin="0,10,0,0"
                           Text="{i18n:T profile.card.no_weeks}"
                           IsVisible="{Binding !HasReadingLog}"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource CardLine}" Margin="0,30"/>

            <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Width="164" Margin="0,0,32,0">
                        <TextBlock Classes="sectionTitle" Text="{i18n:T profile.card.favorite}" Margin="0,0,0,14"/>
                        <Button Classes="cover"
                                IsVisible="{Binding HasFavoriteManga}"
                                Command="{Binding OpenMangaCommand}"
                                CommandParameter="{Binding FavoriteManga}">
                            <StackPanel>
                                <Border Width="164" Height="232" CornerRadius="6" ClipToBounds="True" Background="#222222">
                                    <Image Source="{Binding FavoriteManga.Cover}" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding FavoriteManga.Title}"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Border Width="164" Height="232" CornerRadius="6"
                                BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                IsVisible="{Binding !HasFavoriteManga}">
                            <TextBlock Classes="label" Margin="16" TextWrapping="Wrap"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Text="{i18n:T profile.card.pick_favorite}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="sectionTitle" Text="{i18n:T profile.card.reading_now}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding RecentCollections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentCollectionCardViewModel">
                                    <Button Classes="cover" Margin="0,0,12,0"
                                            Command="{Binding $parent[ItemsControl].((vm:ProfileViewModel)DataContext).OpenCollectionCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Height="160" CornerRadius="6" ClipToBounds="True" Background="#222222">
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                            <ProgressBar Value="{Binding ProgressPct}" Maximum="100"
                                                         MinWidth="0" Height="3" MinHeight="3" CornerRadius="0" Margin="0,8,0,0"
                                                         Background="{StaticResource CardLine}"
                                                         Foreground="{StaticResource CardText}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Margin="0,7,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="label" TextWrapping="Wrap"
                                   Text="{i18n:T profile.card.no_recent}"
                                   IsVisible="{Binding !HasRecentCollections}"/>
                    </StackPanel>
                </Grid>

            <Panel Margin="0,34,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{Binding StreakText}"
                               IsVisible="{Binding HasStreak}" VerticalAlignment="Center"/>
                    <!-- Solo el nombre, como el título de Inicio -->
                    <TextBlock Grid.Column="1" Text="Hakufu"
                               FontSize="24" FontWeight="Black" LetterSpacing="-0.8"
                               VerticalAlignment="Center"/>
                </Grid>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>
