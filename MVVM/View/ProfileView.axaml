<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:v="using:Hakufu.MVVM.View"
             x:Class="Hakufu.MVVM.View.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ BARRA ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,20">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="ghost" Content="← Inicio"
                        Command="{Binding GoBackCommand}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="Editar perfil" Padding="18,10"
                            Command="{Binding EditProfileCommand}"/>
                    <Button Classes="primary" Content="Guardar imagen" Padding="18,10"
                            ToolTip.Tip="Guarda la tarjeta como PNG para compartirla">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Horizontal (ordenador, Twitter…)" Click="SaveHorizontal_Click"/>
                                <MenuItem Header="Vertical (móvil, historias…)" Click="SaveVertical_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TARJETA ═══
             Se encoge si la ventana es pequeña (Viewbox solo hacia abajo). -->
        <Panel Grid.Row="1">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="36,32">
                <v:ProfileCardHorizontal/>
            </Viewbox>

            <!-- Las que se exportan: fuera de la vista y maquetadas ya al doble de
                 tamaño (LayoutTransform), para pintarlas a escala 1 y que el PNG salga
                 nítido. Pedir 192 ppp al pintar escalaba dos veces. -->
            <Canvas Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <LayoutTransformControl Name="ExportHorizontal" LayoutTransform="scale(2)">
                    <v:ProfileCardHorizontal/>
                </LayoutTransformControl>
                <LayoutTransformControl Name="ExportVertical" LayoutTransform="scale(2)">
                    <v:ProfileCardVertical/>
                </LayoutTransformControl>
            </Canvas>
        </Panel>
    </Grid>
</UserControl>
