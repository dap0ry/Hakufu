<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <UserControl.Styles>
        <!-- Etiqueta de sección ("TUS TOP 3 MANGAS", "ESTADÍSTICAS"…) -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <!-- Cabecera "PERFIL" / "HISTORIAL" -->
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Tarjeta clicable de portada: sin cromo, se atenúa al pasar el ratón -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Root" Background="Transparent">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ Border#Root">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Estrella dorada sobre la portada (quita de favoritos) -->
        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="4,4,0,0"/>
            <Setter Property="ZIndex" Value="6"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#66000000">
                        <ContentControl Template="{StaticResource IconPixelStar}"
                                        Width="12" Height="12"
                                        Foreground="#FFD84A"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Marco de portada: sombra fuera, recorte redondeado dentro -->
        <Style Selector="Border.coverShadow">
            <Setter Property="Height" Value="200"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BoxShadow" Value="0 0 12 0 #1F000000"/>
        </Style>
        <Style Selector="Border.coverFrame">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Tarjeta de estadística -->
        <Style Selector="Border.stat">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BoxShadow" Value="0 0 14 0 #12000000"/>
        </Style>

        <Style Selector="Rectangle.divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="Margin" Value="0,0,0,36"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- ═══ MAIN PROFILE ═══ -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowingAllHistory}">

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="40,24,40,24">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Classes="ghost"
                            Content="← Inicio"
                            Command="{Binding GoBackCommand}"
                            Margin="0,0,24,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="header" Text="PERFIL"/>
                        <TextBlock Classes="caption" Text="Estadísticas y actividad reciente"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="ghost"
                            Content="Historial completo"
                            Padding="20,10"
                            Command="{Binding ViewAllHistoryCommand}"/>
                </Grid>
            </Border>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,36,40,40">

                    <!-- ── TUS TOP 3 MANGAS ── -->
                    <TextBlock Classes="section" Text="TUS TOP 3 MANGAS"/>

                    <TextBlock Classes="caption"
                               Text="Marca mangas con la estrellita para verlos aquí."
                               Margin="0,0,0,36"
                               IsVisible="{Binding !HasTopMangas}"/>

                    <ItemsControl ItemsSource="{Binding TopMangas}"
                                  Margin="0,0,0,40"
                                  IsVisible="{Binding HasTopMangas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MangaCardViewModel">
                                <Button Classes="tile" Width="140" Margin="0,0,20,0"
                                        Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).OpenMangaCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Classes="coverShadow">
                                                <Border Classes="coverFrame">
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                </Border>
                                            </Border>
                                            <!-- Estrella: aquí siempre dorada, clic quita del top 3 -->
                                            <Button Classes="star"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    ToolTip.Tip="Quitar de favoritos"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── COLECCIONES FAVORITAS ── -->
                    <TextBlock Classes="section" Text="COLECCIONES FAVORITAS"/>

                    <TextBlock Classes="caption"
                               Text="Marca colecciones con la estrellita en Biblioteca para verlas aquí."
                               Margin="0,0,0,36"
                               IsVisible="{Binding !HasFavoriteCollections}"/>

                    <ItemsControl ItemsSource="{Binding FavoriteCollections}"
                                  Margin="0,0,0,40"
                                  IsVisible="{Binding HasFavoriteCollections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectionCardViewModel">
                                <Button Classes="tile" Width="140" Margin="0,0,20,0"
                                        Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).OpenCollectionCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Border Classes="coverShadow">
                                                <Border Classes="coverFrame">
                                                    <Image Source="{Binding CoverPreviews[0], FallbackValue={x:Null}}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                </Border>
                                            </Border>
                                            <Button Classes="star"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    ToolTip.Tip="Quitar de favoritos"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MangaCount, StringFormat='{}{0} manga(s)'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Classes="divider"/>

                    <!-- ── COMPLETADOS RECIENTEMENTE ── -->
                    <TextBlock Classes="section" Text="COMPLETADOS RECIENTEMENTE"/>

                    <TextBlock Classes="caption"
                               Text="Todavía no has terminado ningún manga."
                               Margin="0,0,0,36"
                               IsVisible="{Binding !HasRecentActivity}"/>

                    <!-- 3 tarjetas anchas que llenan el ancho de la página -->
                    <ItemsControl ItemsSource="{Binding RecentActivity}"
                                  Margin="0,0,0,40"
                                  IsVisible="{Binding HasRecentActivity}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                <Border Height="120" CornerRadius="10" Margin="0,0,16,0"
                                        BoxShadow="0 0 14 0 #14000000">
                                    <Border CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="88,*">
                                            <!-- Cover -->
                                            <Image Grid.Column="0"
                                                   Source="{Binding Cover}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <!-- Info -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,16,0">
                                                <TextBlock Text="COMPLETADO"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding Manga.Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="50"
                                                           Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding TimeAgo}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Classes="divider"/>

                    <!-- ── ESTADÍSTICAS ── -->
                    <TextBlock Classes="section" Text="ESTADÍSTICAS" Margin="0,0,0,20"/>

                    <UniformGrid Columns="3" Margin="0,0,0,40">
                        <!-- Páginas leídas -->
                        <Border Classes="stat" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalPagesRead, StringFormat='{}{0:N0}'}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="páginas leídas"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Colección favorita -->
                        <Border Classes="stat" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="COLECCIÓN FAVORITA"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding FavoriteCollectionName}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           MaxHeight="52"/>
                            </StackPanel>
                        </Border>

                        <!-- Tiempo total -->
                        <Border Classes="stat">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalUsageFormatted}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="tiempo total de uso"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Rectangle Classes="divider"/>

                    <!-- ── PÁGINAS POR COLECCIÓN ── -->
                    <TextBlock Classes="section" Text="PÁGINAS POR COLECCIÓN" Margin="0,0,0,20"/>

                    <TextBlock Classes="caption"
                               Text="Aún no hay datos de lectura por colección."
                               IsVisible="{Binding !HasCollectionStats}"/>

                    <ItemsControl ItemsSource="{Binding CollectionStats}"
                                  IsVisible="{Binding HasCollectionStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CollectionStatViewModel">
                                <Grid ColumnDefinitions="160,*,120" Margin="0,0,0,14">

                                    <!-- Nombre -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding CollectionName}"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Barra: pista + relleno -->
                                    <Grid Grid.Column="1" Name="BarTrack"
                                          VerticalAlignment="Center" Margin="12,0">
                                        <Border Height="10" CornerRadius="5"
                                                Background="{DynamicResource ProgressTrack}"/>
                                        <Border Height="10" CornerRadius="5"
                                                Background="{DynamicResource AccentColor}"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource PercentageWidth}">
                                                    <Binding Path="BarPercent"/>
                                                    <Binding ElementName="BarTrack" Path="Bounds.Width"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>

                                    <!-- Páginas -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PagesRead, StringFormat='{}{0:N0} págs.'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ HISTORIAL COMPLETO ═══ -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowingAllHistory}">

            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="40,24,40,24">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0"
                            Classes="ghost"
                            Content="← Perfil"
                            Command="{Binding BackToProfileCommand}"
                            Margin="0,0,24,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="header" Text="HISTORIAL"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding FullHistory.Count, StringFormat='{}{0} entradas'}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FullHistory}" Margin="40,32,40,40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                            <StackPanel Width="140" Margin="0,0,20,28">
                                <Border Classes="coverShadow">
                                    <Border Classes="coverFrame">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding Manga.Title}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding TimeAgo}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
