<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:i18n="using:Hakufu.I18n"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             xmlns:v="using:Hakufu.MVVM.View"
             x:Class="Hakufu.MVVM.View.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <c:PageHeader Grid.Row="0"
                      Title="{i18n:T profile.title}"
                      Subtitle="{i18n:T profile.subtitle}"
                      BackText="{i18n:T common.back_home}"
                      BackCommand="{Binding GoBackCommand}">
            <c:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="{i18n:T profile.edit}" Padding="18,10"
                            Command="{Binding EditProfileCommand}"/>
                    <Button Classes="primary" Content="{i18n:T profile.save_image}" Padding="18,10"
                            ToolTip.Tip="{i18n:T profile.save_image_tip}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{i18n:T profile.save_horizontal}" Click="SaveHorizontal_Click"/>
                                <MenuItem Header="{i18n:T profile.save_vertical}" Click="SaveVertical_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </c:PageHeader.Actions>
        </c:PageHeader>

        <!-- ═══ TARJETA ═══
             Se encoge si la ventana es pequeña (Viewbox solo hacia abajo). -->
        <Panel Grid.Row="1">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="36,32">
                <v:ProfileCardHorizontal/>
            </Viewbox>

            <!-- Las que se exportan: fuera de la vista y maquetadas ya al doble de
                 tamaño (LayoutTransform), para pintarlas a escala 1 y que el PNG salga
                 nítido. Pedir 192 ppp al pintar escalaba dos veces. -->
            <Canvas Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <LayoutTransformControl Name="ExportHorizontal" LayoutTransform="scale(2)">
                    <v:ProfileCardHorizontal/>
                </LayoutTransformControl>
                <LayoutTransformControl Name="ExportVertical" LayoutTransform="scale(2)">
                    <v:ProfileCardVertical/>
                </LayoutTransformControl>
            </Canvas>
        </Panel>
    </Grid>
</UserControl>
