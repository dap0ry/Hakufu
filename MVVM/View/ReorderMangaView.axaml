<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.ReorderMangaView"
             x:DataType="vm:ReorderMangaViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel#ReorderRoot">
            <Setter Property="Width" Value="420"/>
        </Style>
        <Style Selector=".compact StackPanel#ReorderRoot">
            <Setter Property="Width" Value="NaN"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Name="ReorderRoot">

        <TextBlock Text="{i18n:T collection.reorder_title}"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="{i18n:T collection.reorder_hint}"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReorderItemViewModel">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Classes="icon"
                                            Content="▲" FontSize="9" Width="26" Height="26"
                                            Margin="0,0,4,0"
                                            Command="{Binding $parent[ItemsControl].((vm:ReorderMangaViewModel)DataContext).MoveUpCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Classes="icon"
                                            Content="▼" FontSize="9" Width="26" Height="26"
                                            Command="{Binding $parent[ItemsControl].((vm:ReorderMangaViewModel)DataContext).MoveDownCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="ghost"
                    Content="{i18n:T collection.cancel}"
                    Padding="20,10"
                    Margin="0,0,12,0"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="primary"
                    Content="{i18n:T collection.save_order}"
                    Padding="20,10"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</UserControl>
