<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             x:Class="Hakufu.MVVM.View.ReorderMangaView"
             x:DataType="vm:ReorderMangaViewModel">

    <StackPanel Width="420">

        <TextBlock Text="Orden personalizado"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock Text="Usa las flechas para mover cada manga. Se guarda al pulsar &quot;Guardar orden&quot;."
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReorderItemViewModel">
                        <Border Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                           FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Classes="icon"
                                            Content="▲" FontSize="9" Width="26" Height="26"
                                            Margin="0,0,4,0"
                                            Command="{Binding $parent[ItemsControl].((vm:ReorderMangaViewModel)DataContext).MoveUpCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Classes="icon"
                                            Content="▼" FontSize="9" Width="26" Height="26"
                                            Command="{Binding $parent[ItemsControl].((vm:ReorderMangaViewModel)DataContext).MoveDownCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="ghost"
                    Content="Cancelar"
                    Padding="20,10"
                    Margin="0,0,12,0"
                    Command="{Binding CancelCommand}"/>
            <Button Classes="primary"
                    Content="Guardar orden"
                    Padding="20,10"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</UserControl>
