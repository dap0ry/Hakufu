<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hakufu.MVVM.ViewModel"
             xmlns:c="using:Hakufu.MVVM.View.Controls"
             xmlns:i18n="using:Hakufu.I18n"
             x:Class="Hakufu.MVVM.View.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <!-- Tecla de atajo: parece una tecla; vacía, discontinua; escuchando, invertida -->
        <Style Selector="Button.keycap">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Cap"
                            Height="34" CornerRadius="6" Padding="10,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.keycap.assigned /template/ Border#Cap">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BoxShadow" Value="0 2 0 0 #33000000"/>
        </Style>
        <Style Selector="Button.keycap.assigned /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.keycap:pointerover /template/ Border#Cap">
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Button.keycap.capturing /template/ Border#Cap">
            <Setter Property="Background" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.keycap.capturing /template/ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppBackground}"/>
        </Style>

        <!-- La × para quitar la tecla: en la esquina, solo al pasar el ratón -->
        <Style Selector="Button.keyClear">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,-7,-7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="18" Height="18" CornerRadius="9"
                            Background="{DynamicResource TextPrimary}">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Bold"
                                   Margin="0,-2,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppBackground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Grid:pointerover > Button.keyClear">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ═══ CABECERA ═══ -->
        <c:PageHeader Grid.Row="0"
                      Title="{i18n:T settings.title}"
                      Subtitle="{i18n:T settings.subtitle}"
                      BackText="{i18n:T common.back_home}"
                      BackCommand="{Binding GoBackCommand}">
        </c:PageHeader>

        <!-- ═══ BODY ═══
             El ScrollViewer de Avalonia ya estira el contenido al alto visible,
             así que VerticalAlignment="Center" centra sin el MinHeight de WPF. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="40,40,40,40">

                <!-- ── TEMA ── -->
                <Border Classes="card" Padding="0"
                        Margin="0,0,0,20" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto">

                        <!-- Visual preview (colores fijos a propósito: muestra los dos temas) -->
                        <Grid Grid.Row="0" Height="88" ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Background="#F2F2F2">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Aa"
                                               FontSize="24" FontWeight="Medium"
                                               Foreground="#1A1A1A"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{i18n:T settings.theme_light}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="#999999"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#111111">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Aa"
                                               FontSize="24" FontWeight="Medium"
                                               Foreground="#F0F0F0"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{i18n:T settings.theme_dark}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="#555555"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Toggle row -->
                        <Border Grid.Row="1"
                                Padding="24,18"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T settings.dark_theme}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{i18n:T settings.dark_theme_hint}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Classes="themeToggle"
                                              IsChecked="{Binding IsDarkTheme}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── IDIOMA ── -->
                <Border Classes="card" Padding="24,18" Margin="0,0,0,20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{i18n:T language.title}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="{i18n:T language.subtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="ghost" Content="Español" Padding="12,7" FontSize="11"
                                    Command="{Binding SpanishCommand}"
                                    Opacity="{Binding IsSpanish, Converter={StaticResource BoolToOpacity}}"/>
                            <Button Classes="ghost" Content="English" Padding="12,7" FontSize="11"
                                    Command="{Binding EnglishCommand}"
                                    Opacity="{Binding IsEnglish, Converter={StaticResource BoolToOpacity}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── CARPETA DE LA BIBLIOTECA ──
                     La biblioteca es una carpeta del usuario: cada subcarpeta, una colección. -->
                <Border Classes="card" Padding="0"
                        Margin="0,0,0,20" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="{i18n:T settings.library_folder}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="24,20,24,4"/>

                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0">
                            <StackPanel>
                                <SelectableTextBlock Text="{Binding LibraryRootText}"
                                                     FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     Margin="0,0,0,3"/>
                                <TextBlock Text="{i18n:T settings.library_folder_hint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="{i18n:T settings.choose_folder}" Padding="16,9"
                                            Command="{Binding PickLibraryRootCommand}"/>
                                    <Button Classes="ghost" Content="{i18n:T settings.open_folder}" Padding="16,9"
                                            Command="{Binding OpenLibraryRootCommand}"/>
                                    <Button Classes="ghost" Content="{i18n:T settings.rescan}" Padding="16,9"
                                            Command="{Binding RescanLibraryCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LibraryStatus}"
                                           IsVisible="{Binding LibraryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── LECTURA ── -->
                <Border Classes="card" Padding="0"
                        Margin="0,0,0,20" ClipToBounds="True">
                    <StackPanel>
                        <TextBlock Text="{i18n:T settings.reading}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="24,20,24,4"/>

                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{i18n:T settings.two_pages}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{i18n:T settings.two_pages_hint}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Classes="themeToggle"
                                              IsChecked="{Binding TwoPageByDefault}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{i18n:T settings.zen}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{i18n:T settings.zen_hint}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Classes="themeToggle"
                                              IsChecked="{Binding OpenInZenMode}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding ShowPageTurnSettings}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{i18n:T settings.page_turn}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{i18n:T settings.page_turn_hint}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              Classes="themeToggle"
                                              IsChecked="{Binding PageTurnAnimation}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Velocidad: solo cuenta si hay animación -->
                        <Border Padding="24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                                IsVisible="{Binding ShowPageTurnSettings}"
                                IsEnabled="{Binding PageTurnAnimation}"
                                Opacity="{Binding PageTurnAnimation, Converter={StaticResource BoolToOpacity}}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{i18n:T settings.page_turn_speed}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{i18n:T settings.page_turn_speed_hint}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="ghost" Content="{i18n:T settings.speed_fast}" Padding="12,7" FontSize="11"
                                            Command="{Binding SpeedFastCommand}"
                                            Opacity="{Binding IsSpeedFast, Converter={StaticResource BoolToOpacity}}"/>
                                    <Button Classes="ghost" Content="{i18n:T settings.speed_normal}" Padding="12,7" FontSize="11"
                                            Command="{Binding SpeedNormalCommand}"
                                            Opacity="{Binding IsSpeedNormal, Converter={StaticResource BoolToOpacity}}"/>
                                    <Button Classes="ghost" Content="{i18n:T settings.speed_slow}" Padding="12,7" FontSize="11"
                                            Command="{Binding SpeedSlowCommand}"
                                            Opacity="{Binding IsSpeedSlow, Converter={StaticResource BoolToOpacity}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── ATAJOS DE TECLADO ──
                     Clic en una tecla → "Pulsa una tecla…" → la siguiente que se pulse
                     (con Ctrl/Mayús/Alt si quieres) queda asignada. Clic otra vez: cancelar. -->
                <Border Classes="card" Padding="0" Margin="0,0,0,20" ClipToBounds="True">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="24,20,24,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{i18n:T shortcuts.title}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{i18n:T shortcuts.hint}"
                                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="{i18n:T shortcuts.reset}"
                                    Padding="12,7" FontSize="11" VerticalAlignment="Top"
                                    Command="{Binding ResetShortcutsCommand}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                    <Border Padding="24,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShortcutSlotViewModel">
                                                        <Grid Width="128">
                                                            <Button Classes="keycap"
                                                                    Classes.assigned="{Binding IsAssigned}"
                                                                    Classes.capturing="{Binding IsCapturing}"
                                                                    Content="{Binding Text}"
                                                                    Command="{Binding ClickCommand}"
                                                                    ToolTip.Tip="{i18n:T shortcuts.change_key}"/>
                                                            <Button Classes="keyClear"
                                                                    Content="×"
                                                                    IsVisible="{Binding IsAssigned}"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ClearShortcutCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{i18n:T shortcuts.remove_key}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ShortcutNotice}"
                                   IsVisible="{Binding ShortcutNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="11" Margin="24,0,24,16"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- ── ESPACIO DE DISCO ── -->
                <Border Classes="card" Padding="24"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{i18n:T settings.storage}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,16"/>

                        <!-- Aplicación -->
                        <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{i18n:T settings.storage_app}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AppSizeText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>

                        <!-- Archivos manga del usuario -->
                        <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{i18n:T settings.storage_mangas}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{i18n:T settings.storage_mangas_hint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MangasSizeText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,10"/>

                        <!-- Caché local Hakufu (ya no siempre es %APPDATA%: en macOS y Linux es ~/.config) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{i18n:T settings.storage_cache}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{i18n:T settings.storage_cache_hint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CachesSizeText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── ACERCA DE ── -->
                <Border Classes="card" Padding="24">
                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{i18n:T settings.about}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Hakufu"
                                       FontSize="22" FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{i18n:T settings.tagline}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding VersionText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="{i18n:T settings.platforms}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="{i18n:T settings.developed_by}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="{i18n:T settings.design_by}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                                <Button Classes="ghost"
                                        Content="{i18n:T settings.check_updates}"
                                        Padding="16,9"
                                        Command="{Binding CheckUpdatesCommand}"/>
                                <TextBlock Text="{Binding Updates.CheckStatus}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                            <CheckBox Content="{i18n:T settings.check_updates_on_startup}"
                                      Margin="0,10,0,0"
                                      IsChecked="{Binding CheckUpdatesOnStartup}"/>
                            <Button Classes="ghost"
                                    Content="{i18n:T settings.legal}"
                                    HorizontalAlignment="Left"
                                    Padding="16,9" Margin="0,18,0,0"
                                    Command="{Binding OpenLegalCommand}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="H"
                                   FontSize="72" FontWeight="Black"
                                   Foreground="{DynamicResource DividerBrush}"
                                   VerticalAlignment="Center"
                                   Margin="24,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ── SALIR ── -->
                <Border Classes="card" Padding="24" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="{i18n:T settings.quit}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{i18n:T settings.quit_hint}"
                                   FontSize="12" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>
                        <Button Classes="ghost"
                                Content="{i18n:T settings.quit}"
                                HorizontalAlignment="Left" Padding="20,10"
                                Command="{Binding ExitApplicationCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
