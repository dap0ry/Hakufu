<UserControl x:Class="Hakufu.MVVM.View.StorageManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hakufu.MVVM.ViewModel">

    <StackPanel MinWidth="520" MaxWidth="560">

        <!-- Header -->
        <TextBlock Text="Gestionar espacio"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Borra colecciones enteras o tomos sueltos para liberar espacio"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,20"/>

        <!-- ── LIMPIAR ESPACIO (migrar externos a biblioteca) ── -->
        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="16" Margin="0,0,0,16">
            <StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Limpiar espacio"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding MigrateHintText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Limpiar espacio"
                            Padding="14,8"
                            VerticalAlignment="Center"
                            Command="{Binding RequestMigrateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasExternalMangas}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowMigrateConfirm}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMigrating}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Confirm panel -->
                <Border Background="{DynamicResource SidebarBackground}"
                        CornerRadius="6" Padding="12,10"
                        Margin="0,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowMigrateConfirm}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="¿Confirmar limpieza?"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            Los archivos se copiarán a la biblioteca local y luego se eliminarán de sus ubicaciones originales. Esta acción no se puede deshacer.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}"
                                    Content="Cancelar"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelMigrateCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Sí, limpiar"
                                    Padding="14,7"
                                    Command="{Binding ConfirmMigrateCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress panel -->
                <Border Background="{DynamicResource SidebarBackground}"
                        CornerRadius="6" Padding="12,10"
                        Margin="0,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMigrating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ "
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="{Binding MigrateProgressText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Result panel -->
                <Border Background="{DynamicResource SidebarBackground}"
                        CornerRadius="6" Padding="12,10"
                        Margin="0,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMigrating}"        Value="False"/>
                                        <Condition Binding="{Binding MigrateProgressText}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MigrateProgressText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMigrating}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding MigrateProgressText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>

        <!-- ── ÁRBOL COLECCIONES → TOMOS ── -->
        <TextBlock Text="Borrar colecciones o tomos sueltos"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,8"/>

        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1" CornerRadius="8"
                Margin="0,0,0,4">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Empty state -->
                    <TextBlock Text="No tienes colecciones todavía."
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="18,16"
                               Visibility="{Binding HasCollections, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <ItemsControl ItemsSource="{Binding Collections}"
                                  Visibility="{Binding HasCollections, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StorageCollectionEntryViewModel}">
                                <StackPanel>

                                    <!-- Fila de la colección -->
                                    <Grid Margin="14,10,14,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Expandir/colapsar -->
                                        <ToggleButton Grid.Column="0"
                                                      IsChecked="{Binding IsExpanded}"
                                                      Width="20" Height="20"
                                                      Margin="0,0,10,0"
                                                      VerticalAlignment="Center">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Content" Value="▸"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="▾"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,14,0"/>

                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Borrar la colección entera"/>
                                    </Grid>

                                    <!-- Tomos de la colección -->
                                    <ItemsControl ItemsSource="{Binding Mangas}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:StorageMangaEntryViewModel}">
                                                <Grid Margin="46,6,14,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SizeText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               Margin="12,0,14,0"/>
                                                    <CheckBox Grid.Column="2"
                                                              IsChecked="{Binding IsSelected}"
                                                              IsEnabled="{Binding IsEnabled}"
                                                              ToolTip="Borrar solo este tomo"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <TextBlock Text="{Binding StatusText}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,14"/>

        <!-- Confirm panel de borrado -->
        <Border Background="{DynamicResource SidebarBackground}"
                CornerRadius="6" Padding="12,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowDeleteConfirm}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding DeleteConfirmText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancelar"
                            Padding="14,7"
                            Margin="0,0,8,0"
                            Command="{Binding CancelDeleteCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="14,7"
                            Command="{Binding ConfirmDeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource IconPixelTrash}"
                                            Width="12" Height="12" Margin="0,0,6,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Sí, eliminar"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ruta de los datos -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0">
                <Run Text="Todos tus datos se encuentran en: "/>
                <Run Text="{Binding DataPathText}" FontWeight="SemiBold"/>
            </TextBlock>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Content="Abrir carpeta"
                    Padding="12,7" FontSize="11"
                    VerticalAlignment="Center"
                    Command="{Binding OpenFolderCommand}"/>
        </Grid>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}"
                    Content="Cerrar"
                    Padding="20,10"
                    Margin="0,0,12,0"
                    Command="{Binding CloseCommand}"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Padding="20,10"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding RequestDeleteCommand}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Template="{StaticResource IconPixelTrash}"
                                    Width="13" Height="13" Margin="0,0,8,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="Eliminar seleccionados"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>
</UserControl>
