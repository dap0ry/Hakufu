<UserControl x:Class="Hakufu.MVVM.View.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,24,40,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource GhostButton}"
                        Content="← Inicio"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,24,0"/>
                <TextBlock Grid.Column="1" Text="ACTUALIZACIONES"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="520" HorizontalAlignment="Center"
                        Margin="0,48,0,56">

                <!-- Título -->
                <TextBlock Text="Hakufu"
                           FontSize="28" FontWeight="Black"
                           FontFamily="Segoe UI"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Sistema de actualizaciones"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,0,0,32"/>

                <!-- Version cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}"
                            Padding="20,18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="VERSIÓN ACTUAL"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CurrentVersion}"
                                       FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}"
                            Padding="20,18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMA VERSIÓN"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="—"
                                       FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding IsChecking,
                                           Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding LatestVersion}"
                                       FontSize="20" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{DynamicResource AccentColor}"
                                       Visibility="{Binding IsChecking,
                                           Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Indeterminate progress while checking -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,24,0,0"
                             Foreground="{DynamicResource ProgressFill}"
                             Background="{DynamicResource ProgressTrack}"
                             BorderThickness="0"
                             Visibility="{Binding IsChecking,
                                 Converter={StaticResource BoolToVisibility}}"/>

                <!-- Progreso real de la descarga automática -->
                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Height="3"
                             Margin="0,24,0,0"
                             Foreground="{DynamicResource ProgressFill}"
                             Background="{DynamicResource ProgressTrack}"
                             BorderThickness="0"
                             Visibility="{Binding IsDownloading,
                                 Converter={StaticResource BoolToVisibility}}"/>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,24,0,0"
                           Visibility="{Binding IsChecking,
                               Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Changelog — only when update available -->
                <Border Style="{StaticResource Card}"
                        Padding="24,20"
                        Margin="0,24,0,0"
                        Visibility="{Binding IsUpdateAvailable,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="NOVEDADES"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Changelog}"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="24,11"
                            Command="{Binding UpdateNowCommand}"
                            Visibility="{Binding IsUpdateAvailable,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Template="{StaticResource IconPixelBooks}"
                                            Width="14" Height="14" Margin="0,0,8,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVisibility}}"/>
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Actualizar ahora"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                <Setter Property="Text" Value="Actualizando…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            Content="Comprobar de nuevo"
                            Padding="24,11"
                            Command="{Binding CheckAgainCommand}"
                            Visibility="{Binding IsUpdateAvailable,
                                Converter={StaticResource InverseBoolToVisibility}}"/>
                </StackPanel>

                <!-- Enlace manual de respaldo — siempre visible junto al botón principal por si falla la automática -->
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           FontSize="11"
                           Visibility="{Binding IsUpdateAvailable,
                               Converter={StaticResource BoolToVisibility}}">
                    <Hyperlink Command="{Binding ViewOnGitHubCommand}"
                               Foreground="{DynamicResource TextMuted}"
                               TextDecorations="None">
                        Prefiero descargarla manualmente desde GitHub
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
